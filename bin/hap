#!/usr/bin/env bash

# hap
# https://github.com/thefurdui/hap
# License: MIT

set -e

# --- CONFIG ---
APP_NAME="hap"
VERSION="0.7.0"
XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
DATA_DIR="$XDG_DATA_HOME/$APP_NAME"
DB_FILE="$DATA_DIR/projects.csv"

# Lock file for GUI workspaces
GUI_LOCK_FILE=".hap.gui"

# --- COLORS ---
BLUE='\033[0;34m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
NC='\033[0m'

log_info() { echo -e "${BLUE}INFO:${NC} $1"; }
log_succ() { echo -e "${GREEN}OK:${NC}   $1"; }
log_warn() { echo -e "${YELLOW}WARN:${NC} $1"; }
log_err() { echo -e "${RED}ERR:${NC}  $1" >&2; }

# --- HELPERS ---

zellij_session_exists() {
  local session_name="$1"
  if command -v zellij &>/dev/null; then
    zellij list-sessions 2>/dev/null | grep -q "^${session_name}$" && return 0
  fi
  return 1
}

# --- CLEANUP FUNCTIONS ---

cleanup_workspace() {
  local ws_path="$1"
  local sources_dir="$2"
  local delete_local="${3:-false}"
  local delete_remote="${4:-false}"

  [[ ! -d "$ws_path" ]] && return 0

  # Check for uncommitted changes
  if [[ "$delete_remote" != "true" ]]; then
    for repo in "$ws_path"/*; do
      if [[ -e "$repo/.git" ]]; then
        local status=$(git -C "$repo" status --porcelain 2>/dev/null || echo "")
        if [[ -n "$status" ]]; then
          log_warn "Preserving $(basename "$ws_path") — uncommitted changes"
          return 1
        fi
      fi
    done
  fi

  # Collect branches to delete if requested
  local branches_to_delete=()
  if [[ "$delete_local" == "true" || "$delete_remote" == "true" ]]; then
    for repo in "$ws_path"/*; do
      if [[ -e "$repo/.git" ]]; then
        local branch=$(git -C "$repo" symbolic-ref --short HEAD 2>/dev/null || echo "")
        if [[ -n "$branch" ]]; then
          branches_to_delete+=("$(basename "$repo")|$branch")
        fi
      fi
    done
  fi

  # Move out of directory to avoid locks
  cd / || true

  # Remove worktrees
  for repo in "$ws_path"/*; do
    if [[ -e "$repo/.git" ]]; then
      local repo_name=$(basename "$repo")
      git -C "$sources_dir/$repo_name" worktree prune 2>/dev/null || true
      git -C "$sources_dir/$repo_name" worktree remove "$repo" --force 2>/dev/null || true
    fi
  done

  # Remove GUI lock file
  rm -f "$ws_path/$GUI_LOCK_FILE" 2>/dev/null || true

  # Remove directory (with simple retry)
  local retry=0
  while [[ -d "$ws_path" && $retry -lt 5 ]]; do
    rm -rf "$ws_path" 2>/dev/null || true
    [[ -d "$ws_path" ]] && sleep 0.2 || true
    retry=$((retry + 1))
  done

  if [[ ! -d "$ws_path" ]]; then
    # Delete refs if requested
    for item in "${branches_to_delete[@]}"; do
      local repo_name="${item%|*}"
      local branch="${item#*|}"
      local source_repo="$sources_dir/$repo_name"

      if [[ -d "$source_repo" ]]; then
        if [[ "$delete_remote" == "true" ]]; then
          log_info "Deleting remote branch $branch for $repo_name..."
          git -C "$source_repo" push origin --delete "$branch" 2>/dev/null || true
        fi
        if [[ "$delete_local" == "true" ]]; then
          log_info "Deleting local branch $branch for $repo_name..."
          git -C "$source_repo" branch -D "$branch" 2>/dev/null || true
        fi
      fi
    done
    return 0
  else
    return 1
  fi
}

cleanup_project_workspaces() {
  local project_root="$1"
  local task="$2"
  local sources_dir="$project_root/sources"
  local workspaces_dir="$project_root/workspaces"

  [[ ! -d "$workspaces_dir" ]] && return

  # Confirmation for Remote Delete
  if [[ "$DELETE_REMOTE" == "true" && "$CONFIRM_YES" != "true" ]]; then
    echo -n "WARNING: You are about to delete REMOTE branches. This cannot be undone. Continue? [y/N] "
    read -r response
    if [[ ! "$response" =~ ^[yY]$ ]]; then
      log_warn "Aborted by user."
      return
    fi
  fi

  local delete_local="true"
  local delete_remote="$DELETE_REMOTE"

  if [[ -n "$task" ]]; then
    # TARGETED CLEANUP: TRUST THE USER
    local ws_path="$workspaces_dir/$task"
    log_info "Cleaning workspace: $task"
    if cleanup_workspace "$ws_path" "$sources_dir" "$delete_local" "$delete_remote"; then
      log_succ "Cleaned: $task"
    else
      log_warn "Failed to clean: $task (maybe uncommitted changes?)"
    fi
  else
    # BULK CLEANUP: SAFETY IS PARAMOUNT
    log_info "Running bulk cleanup for inactive workspaces..."
    for ws_path in "$workspaces_dir"/*; do
      [[ ! -d "$ws_path" ]] && continue
      local ws_name=$(basename "$ws_path")
      [[ "$ws_name" == "main" ]] && continue

      local is_active=0

      # 1. Check for GUI Lock
      if [[ -f "$ws_path/$GUI_LOCK_FILE" ]]; then
        is_active=1
      # 2. Check for Zellij Session
      else
        local session_name="$(basename "$project_root")-$ws_name"
        if zellij_session_exists "$session_name"; then is_active=1; fi
      fi

      if [[ $is_active -eq 1 ]]; then
        continue
      fi

      if cleanup_workspace "$ws_path" "$sources_dir" "$delete_local" "$delete_remote"; then
        log_succ "Cleaned: $ws_name"
      fi
    done
  fi
}

# --- SETUP ---

ensure_setup() {
  local editor="${1:-zellij}"
  mkdir -p "$DATA_DIR"
  [[ ! -f "$DB_FILE" ]] && touch "$DB_FILE" || true

  for cmd in fzf git; do
    if ! command -v "$cmd" &>/dev/null; then
      log_err "Missing dependency: $cmd"
      exit 1
    fi
  done

  if ! command -v "$editor" &>/dev/null; then
    log_err "Missing dependency: $editor"
    exit 1
  fi
}

ensure_db() {
  mkdir -p "$DATA_DIR"
  [[ ! -f "$DB_FILE" ]] && touch "$DB_FILE" || true
}

# --- SESSION LAUNCH ---

launch_session() {
  local project_name="$1"
  local workspace_path="$2"
  local session_name="$3"
  local project_root="$4"
  local editor="${5:-zellij}"

  [[ ! -d "$workspace_path" ]] && {
    log_err "Path not found: $workspace_path"
    exit 1
  }

  cd "$workspace_path" || exit 1

  log_info "Launching $project_name with $editor..."

  case "$editor" in
  zellij)
    # Prune Zellij session if it exists (Restart context)
    zellij delete-session "$session_name" 2>/dev/null || true

    local layout_file=""
    local project_config_dir="$project_root/config"

    if [[ -f "$project_config_dir/hap.kdl" ]]; then
      layout_file="$project_config_dir/hap.kdl"
    fi

    local args=()
    [[ -n "$layout_file" ]] && args+=("--new-session-with-layout" "$layout_file") || true
    args+=("--session" "$session_name")

    unset ZELLIJ ZELLIJ_SESSION_NAME ZELLIJ_PANE_ID
    log_info "Command: zellij ${args[*]}"

    # HAP_UP controls whether server panes auto-run their start commands.
    # Only affects initial session creation — after that, manage servers
    # manually inside the running zellij session.
    if [[ "$START_UP" == "true" ]]; then
      export HAP_UP=1
    else
      unset HAP_UP
    fi

    # Run as subprocess (Blocking, but Zellij takes over terminal)
    env -u ZELLIJ -u ZELLIJ_SESSION_NAME -u ZELLIJ_PANE_ID zellij "${args[@]}" || true
    ;;
  cursor | antigravity)
    # Create Lock File (Prevents Bulk Cleanup)
    touch "$GUI_LOCK_FILE"

    log_info "Opening $editor..."
    # NO --wait. Fire and forget.
    if [[ "$editor" == "cursor" ]]; then
      cursor .
    else
      "$editor" .
    fi
    ;;
  *)
    log_err "Unsupported editor: $editor"
    exit 1
    ;;
  esac
}

# --- WORKSPACE ---

create_workspace() {
  local project_root="$1"
  local project_name="$2"
  local agent_task="$3"
  local base_branch="$4"
  local editor="${5:-zellij}"
  local target_branch_prefix="$6"

  local sources_dir="$project_root/sources"
  local target_ws="$project_root/workspaces/$agent_task"

  if [[ -d "$target_ws" ]]; then
    log_warn "Resuming existing workspace: $agent_task"
  else
    log_info "Spawning workspace: $agent_task (base: $base_branch)"
    mkdir -p "$target_ws"

    for repo in "$sources_dir"/*; do
      local repo_name=$(basename "$repo")
      if [[ -d "$repo" && -d "$repo/.git" ]]; then
        local branch_name=""

        if [[ -n "$target_branch_prefix" ]]; then
          branch_name="${target_branch_prefix}"
        else
          branch_name="hap/${agent_task}"
        fi

        git -C "$repo" worktree prune

        if ! git -C "$repo" worktree add "$target_ws/$repo_name" -b "$branch_name" "$base_branch" 2>/dev/null; then
          git -C "$repo" worktree add "$target_ws/$repo_name" "$branch_name"
        fi

        git -C "$target_ws/$repo_name" push -u origin "$branch_name" 2>/dev/null || true

        # Shared State Linking
        if [[ -d "$project_root/shared/$repo_name" ]]; then
          log_info "Linking shared state for $repo_name..."
          (
            cd "$project_root/shared/$repo_name" || exit
            find . -type f | while read -r file; do
              local clean_file="${file#./}"
              local dest_file="$target_ws/$repo_name/$clean_file"
              local dest_dir=$(dirname "$dest_file")

              mkdir -p "$dest_dir"

              local ups="../../../"
              local subdir=$(dirname "$clean_file")
              if [[ "$subdir" != "." ]]; then
                local sub_depth=$(echo "$subdir" | awk -F/ '{print NF}')
                for ((i = 0; i < sub_depth; i++)); do ups="../$ups"; done
              fi

              ln -sf "${ups}shared/$repo_name/$clean_file" "$dest_file"
            done
          )
        fi

        if [[ -f "$target_ws/$repo_name/pnpm-lock.yaml" ]]; then
          (cd "$target_ws/$repo_name" && pnpm install --frozen-lockfile --silent &)
        elif [[ -f "$target_ws/$repo_name/go.mod" ]]; then
          (cd "$target_ws/$repo_name" && go mod download &)
        fi
      else
        log_info "Linking source: $repo_name"
        ln -sf "$repo" "$target_ws/$repo_name"
      fi
    done

    # Global Shared Linking
    if [[ -d "$project_root/shared" ]]; then
      for item in "$project_root/shared"/*; do
        local item_name=$(basename "$item")
        if [[ ! -e "$target_ws/$item_name" ]]; then
          log_info "Linking shared item: $item_name"
          ln -sf "$item" "$target_ws/$item_name"
        fi
      done
    fi

    wait
    log_succ "Workspace ready"
  fi

  local original_dir=$(pwd)
  cd "$target_ws" || exit 1
  launch_session "$project_name" "$target_ws" "$project_name-$agent_task" "$project_root" "$editor"
  cd "$original_dir" || true
}

# --- INIT ---

hap_init() {
  local project_name="${1:-$(basename "$(pwd)")}"
  local project_root="$(pwd)"

  # Guard: already initialized
  if [[ -d "$project_root/sources" ]]; then
    log_err "Already initialized (sources/ directory exists)"
    exit 1
  fi

  # Detect git repos
  local repos=()
  local is_root_repo=false

  # Level 0: is the current directory itself a git repo?
  if [[ -d "$project_root/.git" ]]; then
    is_root_repo=true
    repos+=("$project_name")
    log_info "Detected root-level repo: $project_name"
  else
    # Level 1: immediate subdirectories with .git
    for dir in "$project_root"/*/; do
      [[ ! -d "$dir" ]] && continue
      if [[ -d "$dir/.git" ]]; then
        local name
        name=$(basename "$dir")
        repos+=("$name")
        log_info "Detected repo: $name"
      fi
    done
  fi

  if [[ ${#repos[@]} -eq 0 ]]; then
    log_err "No git repositories found"
    log_err "Expected .git in current directory, or subdirectories containing .git"
    exit 1
  fi

  log_info "Initializing hap project: $project_name (${#repos[@]} repo(s))"

  # Create scaffold
  mkdir -p "$project_root/sources"
  mkdir -p "$project_root/workspaces/main"
  mkdir -p "$project_root/config"
  mkdir -p "$project_root/shared"

  if [[ "$is_root_repo" == true ]]; then
    # --- Single repo at root ---
    # Move everything into sources/<project_name>, then create a worktree back out.
    local staging="$project_root/.hap-init-staging"
    mkdir -p "$staging"

    # Move all contents to staging (visible + dotfiles, skip scaffold dirs)
    for item in "$project_root"/* "$project_root"/.[!.]*; do
      [[ ! -e "$item" ]] && continue
      local item_name
      item_name=$(basename "$item")
      case "$item_name" in
      sources | workspaces | config | shared | .hap-init-staging) continue ;;
      esac
      mv "$item" "$staging/" 2>/dev/null || true
    done

    # Staging becomes the source repo
    mv "$staging" "$project_root/sources/$project_name"

    # Detach HEAD in source to free the branch name for the worktree
    local current_branch
    current_branch=$(git -C "$project_root/sources/$project_name" symbolic-ref --short HEAD 2>/dev/null || echo "")

    if [[ -n "$current_branch" ]]; then
      git -C "$project_root/sources/$project_name" checkout --detach 2>/dev/null
      git -C "$project_root/sources/$project_name" worktree add \
        "$project_root/workspaces/main/$project_name" "$current_branch" 2>/dev/null
      log_succ "Worktree: main/$project_name ($current_branch)"
    else
      log_warn "Could not determine branch for $project_name, skipping worktree"
    fi
  else
    # --- Multi-repo ---
    # Move each repo dir to sources/, create worktrees, collect leftovers.
    local misc_items=()

    for item in "$project_root"/*; do
      [[ ! -e "$item" ]] && continue
      local item_name
      item_name=$(basename "$item")

      # Skip scaffold dirs
      case "$item_name" in
      sources | workspaces | config | shared | misc) continue ;;
      esac

      if [[ -d "$item/.git" ]]; then
        # Git repo — move to sources
        mv "$item" "$project_root/sources/$item_name"

        local current_branch
        current_branch=$(git -C "$project_root/sources/$item_name" symbolic-ref --short HEAD 2>/dev/null || echo "")

        if [[ -n "$current_branch" ]]; then
          git -C "$project_root/sources/$item_name" checkout --detach 2>/dev/null
          git -C "$project_root/sources/$item_name" worktree add \
            "$project_root/workspaces/main/$item_name" "$current_branch" 2>/dev/null
          log_succ "Worktree: main/$item_name ($current_branch)"
        else
          log_warn "Could not determine branch for $item_name, skipping worktree"
        fi
      else
        misc_items+=("$item")
      fi
    done

    # Collect dotfiles as misc too
    for item in "$project_root"/.[!.]*; do
      [[ ! -e "$item" ]] && continue
      misc_items+=("$item")
    done

    # Move leftovers to misc/
    if [[ ${#misc_items[@]} -gt 0 ]]; then
      mkdir -p "$project_root/misc"
      for item in "${misc_items[@]}"; do
        mv "$item" "$project_root/misc/" 2>/dev/null || true
      done
      log_info "Moved ${#misc_items[@]} non-repo item(s) to misc/"
    fi
  fi

  # Copy layout template to config/
  local script_dir
  script_dir="$(cd "$(dirname "$0")" && pwd -P)"
  local hap_root
  hap_root="$(dirname "$script_dir")"
  local template="$hap_root/templates/hap.kdl"

  if [[ -f "$template" ]]; then
    cp "$template" "$project_root/config/hap.kdl"
    log_succ "Copied layout template to config/hap.kdl"
  elif [[ -f "$DATA_DIR/templates/hap.kdl" ]]; then
    cp "$DATA_DIR/templates/hap.kdl" "$project_root/config/hap.kdl"
    log_succ "Copied layout template to config/hap.kdl"
  else
    log_warn "Layout template not found — copy templates/hap.kdl to config/hap.kdl manually"
  fi

  # Register project (upsert)
  mkdir -p "$DATA_DIR"
  [[ ! -f "$DB_FILE" ]] && touch "$DB_FILE"
  if grep -q "^${project_name}|" "$DB_FILE" 2>/dev/null; then
    local tmp_db
    tmp_db=$(mktemp)
    grep -v "^${project_name}|" "$DB_FILE" >"$tmp_db"
    mv "$tmp_db" "$DB_FILE"
  fi
  echo "${project_name}|${project_root}" >>"$DB_FILE"

  echo ""
  log_succ "Project initialized: $project_name"
  log_info "Next steps:"
  log_info "  1. Edit config/hap.kdl — set cwd paths and server commands"
  log_info "  2. Run: hap open $project_name"
}

# --- COMMANDS ---

hap_open() {
  local project="" workspace="" editor="zellij" base_branch="dev" target_branch=""
  START_UP="false"

  while [[ $# -gt 0 ]]; do
    case "$1" in
    -u) START_UP="true"; shift ;;
    -e) editor="${2:?'-e requires an editor name'}"; shift 2 ;;
    -b) base_branch="${2:?'-b requires a branch name'}"; shift 2 ;;
    -B) target_branch="${2:?'-B requires a branch name'}"; shift 2 ;;
    -*)
      log_err "Unknown option: $1"
      log_err "Usage: hap open <project> [workspace] [-u] [-e editor] [-b branch] [-B branch]"
      exit 1
      ;;
    *)
      if [[ -z "$project" ]]; then
        project="$1"
      elif [[ -z "$workspace" ]]; then
        workspace="$1"
      else
        log_err "Unexpected argument: $1"
        exit 1
      fi
      shift
      ;;
    esac
  done

  if [[ -z "$project" ]]; then
    log_err "Project name required"
    log_err "Usage: hap open <project> [workspace] [-u] [-e editor]"
    exit 1
  fi

  ensure_setup "$editor"

  local path_to_root
  path_to_root=$(grep "^${project}|" "$DB_FILE" | cut -d '|' -f 2 || true)
  if [[ -z "$path_to_root" ]]; then
    log_err "Project not found: $project"
    exit 1
  fi

  if [[ -n "$workspace" ]]; then
    create_workspace "$path_to_root" "$project" "$workspace" "$base_branch" "$editor" "$target_branch"
  else
    launch_session "$project" "$path_to_root/workspaces/main" "$project-main" "$path_to_root" "$editor"
  fi
}

hap_add() {
  local name="${1:?'Project name required. Usage: hap add <name> [path]'}"
  local path="${2:-.}"

  ensure_db

  local full_path
  [[ "$path" == "." ]] && full_path="$(pwd)" || full_path="$(cd "$path" && pwd)"

  # Upsert: remove old entry if exists
  if grep -q "^${name}|" "$DB_FILE" 2>/dev/null; then
    local tmp_db
    tmp_db=$(mktemp)
    grep -v "^${name}|" "$DB_FILE" >"$tmp_db"
    mv "$tmp_db" "$DB_FILE"
  fi

  echo "$name|$full_path" >>"$DB_FILE"
  log_succ "Registered: $name → $full_path"
}

hap_remove() {
  local name="${1:?'Project name required. Usage: hap remove <name>'}"

  ensure_db

  if ! grep -q "^${name}|" "$DB_FILE" 2>/dev/null; then
    log_err "Project not found: $name"
    exit 1
  fi

  local tmp_db
  tmp_db=$(mktemp)
  grep -v "^${name}|" "$DB_FILE" >"$tmp_db"
  mv "$tmp_db" "$DB_FILE"
  log_succ "Removed: $name"
}

hap_clean() {
  local project="" workspace=""
  DELETE_REMOTE="false"
  CONFIRM_YES="false"

  while [[ $# -gt 0 ]]; do
    case "$1" in
    -D) DELETE_REMOTE="true"; shift ;;
    -y) CONFIRM_YES="true"; shift ;;
    -*)
      log_err "Unknown option: $1"
      log_err "Usage: hap clean <project> [workspace] [-D] [-y]"
      exit 1
      ;;
    *)
      if [[ -z "$project" ]]; then
        project="$1"
      elif [[ -z "$workspace" ]]; then
        workspace="$1"
      else
        log_err "Unexpected argument: $1"
        exit 1
      fi
      shift
      ;;
    esac
  done

  if [[ -z "$project" ]]; then
    log_err "Project name required"
    log_err "Usage: hap clean <project> [workspace] [-D] [-y]"
    exit 1
  fi

  ensure_db

  local path_to_root
  path_to_root=$(grep "^${project}|" "$DB_FILE" | cut -d '|' -f 2 || true)
  if [[ -z "$path_to_root" ]]; then
    log_err "Project not found: $project"
    exit 1
  fi

  cleanup_project_workspaces "$path_to_root" "$workspace"
}

hap_list() {
  ensure_db
  if [[ ! -s "$DB_FILE" ]]; then
    log_warn "No projects registered. Use 'hap init' to get started."
    exit 0
  fi
  column -t -s "|" "$DB_FILE"
}

hap_interactive() {
  ensure_setup "zellij"
  START_UP="false"

  if [[ ! -s "$DB_FILE" ]]; then
    log_warn "No projects found. Use 'hap init' in your project directory."
    exit 0
  fi

  local selection
  selection=$(fzf --height=40% --layout=reverse --border --prompt="Select project > " --delimiter="|" --with-nth=1,2 <"$DB_FILE")
  if [[ -n "$selection" ]]; then
    local name path_to_root
    name=$(echo "$selection" | cut -d '|' -f 1)
    path_to_root=$(echo "$selection" | cut -d '|' -f 2)
    launch_session "$name" "$path_to_root/workspaces/main" "$name-main" "$path_to_root" "zellij"
  fi
}

# --- CLI ---

usage() {
  cat <<EOF
Usage: hap <command> [args] [flags]

Commands:
  init [name]                    Scaffold project from current directory
  open <project> [workspace]     Open project or workspace
  add <name> [path]              Register a project
  remove <name>                  Unregister a project
  clean <project> [workspace]    Cleanup workspace(s)
  list                           List registered projects
  help                           Show this help
  version                        Show version

Flags for 'open':
  -u              Auto-start servers (like docker compose up)
  -e <editor>     Editor: zellij (default), cursor, antigravity
  -b <branch>     Base branch for new workspace (default: dev)
  -B <branch>     Target branch name (default: hap/<workspace>)

Flags for 'clean':
  -D              Also delete remote branches
  -y              Skip confirmation (with -D)

Run 'hap' with no arguments for interactive project selection.
EOF
}

# --- MAIN ---

case "${1:-}" in
  init)    shift; hap_init "$@" ;;
  open)    shift; hap_open "$@" ;;
  add)     shift; hap_add "$@" ;;
  remove)  shift; hap_remove "$@" ;;
  clean)   shift; hap_clean "$@" ;;
  list)    hap_list ;;
  version|-v|--version) echo "hap v$VERSION" ;;
  help|-h|--help) usage ;;
  "")      hap_interactive ;;
  *)       log_err "Unknown command: $1"; echo ""; usage; exit 1 ;;
esac
