#!/usr/bin/env bash

# hap
# https://github.com/thefurdui/hap
# License: MIT

set -e

# --- CONFIG ---
APP_NAME="hap"
VERSION="1.1.0"
XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
DATA_DIR="$XDG_DATA_HOME/$APP_NAME"
DB_FILE="$DATA_DIR/projects.csv"

# Lock file for GUI workspaces
GUI_LOCK_FILE=".hap.gui"

# --- COLORS ---
BLUE='\033[0;34m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

log_info() { echo -e "${BLUE}INFO:${NC} $1"; }
log_succ() { echo -e "${GREEN}OK:${NC}   $1"; }
log_warn() { echo -e "${YELLOW}WARN:${NC} $1"; }
log_err() { echo -e "${RED}ERR:${NC}  $1" >&2; }

# --- HELPERS ---

validate_name() {
  [[ "$1" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]] && return 0
  log_err "Invalid $2: $1 (use letters, digits, dots, underscores, or hyphens)"
  return 1
}

validate_project_root() {
  local root="$1" part
  [[ "$root" == /* && -d "$root" ]] || { log_err "Invalid project root: $root"; return 1; }
  for part in sources workspaces shared data config; do
    [[ ! -L "$root/$part" ]] || { log_err "Refusing symlinked project directory: $part"; return 1; }
  done
}

validate_workspace_path() {
  local root="$1" name="$2"
  validate_name "$name" workspace || return 1
  validate_project_root "$root" || return 1
  [[ ! -L "$root/workspaces/$name" ]] || { log_err "Refusing symlinked workspace: $name"; return 1; }
}

# A checked-out branch may contain symlinks. Never follow them while provisioning.
safe_destination() {
  local root="$1" relative="$2" component current="$1"
  local -a components
  [[ -d "$root" && ! -L "$root" && "$relative" != /* ]] || return 1
  IFS=/ read -r -a components <<<"$relative"
  for component in "${components[@]}"; do
    case "$component" in ''|.|..|.git) log_err "Unsafe state path: $relative"; return 1 ;; esac
    current="$current/$component"
    if [[ -L "$current" ]]; then
      log_err "Refusing symlink in state destination: $current"
      return 1
    fi
  done
}

# Directories to exclude when scanning for state files
STATE_EXCLUDE_DIRS="node_modules vendor .git dist build"

# Build find exclusion arguments from the directory list
_build_find_excludes() {
  local args=()
  local first=true
  for dir in $STATE_EXCLUDE_DIRS; do
    if [[ "$first" == true ]]; then
      args+=("-name" "$dir")
      first=false
    else
      args+=("-o" "-name" "$dir")
    fi
  done
  # Return: \( -name node_modules -o -name vendor ... \) -prune
  echo "(" "${args[@]}" ")" "-prune"
}

# Extract shared config files (.env, .pem, .crt, .key) preserving directory structure.
# Args: <repo_source_path> <shared_dest_dir>
# Populates the global SHARED_MOVED array with "<relative_path>" entries.
SHARED_MOVED=()
extract_shared_state() {
  local repo_path="$1"
  local dest_dir="$2"

  SHARED_MOVED=()
  (
    cd "$repo_path" || return
    # Find config files, excluding build/vendor dirs
    find . \( -name node_modules -o -name vendor -o -name .git -o -name dist -o -name build \) -prune \
      -o \( -name '.env' -o -name '.env.*' -o -name '*.pem' -o -name '*.crt' -o -name '*.key' \) -type f -print
  ) | while IFS= read -r file; do
    local clean_file="${file#./}"
    local dest_file="$dest_dir/$clean_file"
    mkdir -p "$(dirname "$dest_file")"
    mv "$repo_path/$clean_file" "$dest_file"
    echo "$clean_file"
  done
}

# Extract mutating data files (.db, .sqlite, .log, WAL) preserving directory structure.
# Args: <repo_source_path> <data_dest_dir>
# Outputs moved file paths to stdout (one per line).
extract_data_state() {
  local repo_path="$1"
  local dest_dir="$2"

  (
    cd "$repo_path" || return
    find . \( -name node_modules -o -name vendor -o -name .git -o -name dist -o -name build \) -prune \
      -o \( -name '*.db' -o -name '*.sqlite' -o -name '*.sqlite3' -o -name '*.db-wal' -o -name '*.db-shm' -o -name '*.log' \) -type f -print
  ) | while IFS= read -r file; do
    local clean_file="${file#./}"
    local dest_file="$dest_dir/$clean_file"
    mkdir -p "$(dirname "$dest_file")"
    mv "$repo_path/$clean_file" "$dest_file"
    echo "$clean_file"
  done
}

# Print a highly visible summary block of what was moved during init.
# Args: <repo_name> <shared_files_string> <data_files_string> <project_root>
print_state_extraction_summary() {
  local repo_name="$1"
  local shared_files="$2"
  local data_files="$3"
  local project_root="$4"

  if [[ -z "$shared_files" && -z "$data_files" ]]; then
    return
  fi

  echo ""
  echo -e "${CYAN}${BOLD}╔══════════════════════════════════════════════════════════════╗${NC}"
  echo -e "${CYAN}${BOLD}║  STATE EXTRACTION REPORT: ${repo_name}${NC}"
  echo -e "${CYAN}${BOLD}╚══════════════════════════════════════════════════════════════╝${NC}"

  if [[ -n "$shared_files" ]]; then
    echo ""
    echo -e "  ${GREEN}${BOLD}shared/${repo_name}/${NC} ${DIM}(config — symlinked into workspaces)${NC}"
    while IFS= read -r f; do
      [[ -z "$f" ]] && continue
      echo -e "    ${DIM}→${NC} $f"
    done <<<"$shared_files"
  fi

  if [[ -n "$data_files" ]]; then
    echo ""
    echo -e "  ${YELLOW}${BOLD}data/${repo_name}/${NC} ${DIM}(databases/logs — never symlinked)${NC}"
    while IFS= read -r f; do
      [[ -z "$f" ]] && continue
      echo -e "    ${DIM}→${NC} $f"
    done <<<"$data_files"
  fi

  if [[ -n "$shared_files" && -n "$data_files" ]]; then
    echo ""
    echo -e "  ${YELLOW}${BOLD}⚠  ACTION REQUIRED:${NC}"
    echo -e "  ${YELLOW}Update .env files in shared/ to point to data/ using relative paths.${NC}"
    echo -e "  ${DIM}From a workspace, the path escapes up through workspaces/<ws>/<repo>/...${NC}"
    echo ""
    echo -e "  ${DIM}Example:${NC}"
    echo -e "  ${DIM}  If .env is at:  shared/${repo_name}/apps/api/.env${NC}"
    echo -e "  ${DIM}  And DB is at:   data/${repo_name}/apps/api/dev.db${NC}"
    echo -e "  ${DIM}  Then in .env:   DB_PATH=../../../../../data/${repo_name}/apps/api/dev.db${NC}"
    echo -e "  ${DIM}  (resolve from workspace: workspaces/<ws>/${repo_name}/apps/api/ → ../../../../.. → project root)${NC}"
  fi

  echo -e "${CYAN}${BOLD}────────────────────────────────────────────────────────────────${NC}"
}

# Return 0 for active/resumable, 1 for absent, 2 for unknown. Unknown is unsafe.
zellij_session_exists() {
  local session_name="$1" sessions
  if ! command -v zellij >/dev/null 2>&1; then
    log_err "Cannot determine session activity: zellij is unavailable"
    return 2
  fi
  if ! sessions=$(zellij list-sessions --short --no-formatting); then
    log_err "Cannot determine session activity"
    return 2
  fi
  grep -Fxq -- "$session_name" <<<"$sessions"
}

workspace_is_active() {
  local project_name="$1" ws_path="$2"
  [[ ! -e "$ws_path/$GUI_LOCK_FILE" ]] || return 0
  zellij_session_exists "$project_name-${ws_path##*/}"
}

# --- CLEANUP FUNCTIONS ---

cleanup_workspace() {
  local ws_path="$1" sources_dir="$2" delete_remote="${4:-false}"
  local repo source_repo repo_name status tip branch common git_dir remote_tip
  local -a repos=() branches=() tips=()
  [[ -d "$ws_path" ]] || { log_err "Workspace not found: $ws_path"; return 1; }

  # Inventory every entry, including ignored files and workspace-level notes.
  # Unknown contents are never disposable merely because Git cannot see them.
  for repo in "$ws_path"/* "$ws_path"/.[!.]* "$ws_path"/..?*; do
    [[ -e "$repo" || -L "$repo" ]] || continue
    [[ "$repo" == "$ws_path/$GUI_LOCK_FILE" && -f "$repo" && ! -L "$repo" ]] && continue
    repo_name="${repo##*/}"
    source_repo="$sources_dir/$repo_name"
    if [[ -L "$repo" || ! -f "$repo/.git" || -L "$repo/.git" || -L "$source_repo" || ! -d "$source_repo/.git" ]]; then
      log_err "Preserving unknown workspace entry: $repo"
      return 1
    fi
    common=$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir) || return 1
    [[ "$common" == "$(cd "$source_repo/.git" && pwd -P)" ]] || { log_err "Worktree belongs to another source: $repo"; return 1; }
    git_dir=$(git -C "$repo" rev-parse --absolute-git-dir) || return 1
    [[ ! -e "$git_dir/locked" ]] || { log_err "Worktree is locked: $repo"; return 1; }
    status=$(git -C "$repo" status --porcelain --untracked-files=all --ignored) || {
      log_err "Cannot inspect $repo"; return 1;
    }
    [[ -z "$status" ]] || { log_warn "Preserving $repo — local or ignored files present"; return 1; }
    tip=$(git -C "$repo" rev-parse --verify HEAD) || return 1
    branch=$(git -C "$repo" symbolic-ref --quiet --short HEAD) || branch=""
    if [[ "$delete_remote" == true && -n "$branch" ]]; then
      remote_tip=$(git -C "$repo" ls-remote --exit-code --heads origin "refs/heads/$branch") || {
        log_err "Cannot verify remote branch: $branch"; return 1;
      }
      remote_tip="${remote_tip%%$'\t'*}"
      [[ "$remote_tip" == "$tip" ]] || { log_err "Remote branch differs from local history: $branch"; return 1; }
    fi
    repos+=("$repo")
    branches+=("$branch")
    tips+=("$tip")
  done

  local i recovery
  for ((i = 0; i < ${#repos[@]}; i++)); do
    repo="${repos[i]}"
    source_repo="$sources_dir/${repo##*/}"
    if [[ -z "${branches[i]}" ]]; then
      recovery="refs/hap/recovery/${ws_path##*/}/${repo##*/}-${tips[i]}"
      git -C "$repo" update-ref "$recovery" "${tips[i]}" || return 1
      log_info "Preserved detached history at $recovery"
    fi
    # Never replace Git's refusal with recursive filesystem deletion.
    git -C "$source_repo" worktree remove "$repo" || return 1
    if [[ "$delete_remote" == true && -n "${branches[i]}" ]]; then
      branch="${branches[i]}"
      git -C "$source_repo" push --force-with-lease="refs/heads/$branch:${tips[i]}" origin ":refs/heads/$branch" || return 1
    fi
  done
  rm -f "$ws_path/$GUI_LOCK_FILE" || return 1
  rmdir "$ws_path" || return 1
}

cleanup_project_workspaces() {
  local project_root="$1"
  local task="$2"
  local project_name="$3"
  local sources_dir="$project_root/sources"
  local workspaces_dir="$project_root/workspaces"
  validate_project_root "$project_root" || return 1

  [[ ! -d "$workspaces_dir" ]] && return

  # Confirmation for Remote Delete
  if [[ "$DELETE_REMOTE" == "true" && "$CONFIRM_YES" != "true" ]]; then
    echo -n "WARNING: You are about to delete REMOTE branches. This cannot be undone. Continue? [y/N] "
    read -r response
    if [[ ! "$response" =~ ^[yY]$ ]]; then
      log_warn "Aborted by user."
      return
    fi
  fi

  local delete_local="false"
  local delete_remote="$DELETE_REMOTE"

  if [[ -n "$task" ]]; then
    validate_workspace_path "$project_root" "$task" || return 1
    # TARGETED CLEANUP: TRUST THE USER
    local ws_path="$workspaces_dir/$task"
    log_info "Cleaning workspace: $task"
    if cleanup_workspace "$ws_path" "$sources_dir" "$delete_local" "$delete_remote"; then
      log_succ "Cleaned: $task"
    else
      log_warn "Failed to clean: $task (maybe uncommitted changes?)"
    fi
  else
    # BULK CLEANUP: SAFETY IS PARAMOUNT
    log_info "Running bulk cleanup for inactive workspaces..."
    for ws_path in "$workspaces_dir"/*; do
      [[ ! -d "$ws_path" ]] && continue
      local ws_name=$(basename "$ws_path")
      validate_workspace_path "$project_root" "$ws_name" || return 1
      [[ "$ws_name" == "main" ]] && continue

      local activity
      if workspace_is_active "$project_name" "$ws_path"; then
        log_info "Preserving active or resumable workspace: $ws_name"
        continue
      else
        activity=$?
        [[ $activity -eq 1 ]] || return 1
      fi

      if cleanup_workspace "$ws_path" "$sources_dir" "$delete_local" "$delete_remote"; then
        log_succ "Cleaned: $ws_name"
      fi
    done
  fi
}

# --- SETUP ---

ensure_setup() {
  local editor="${1:-zellij}"
  mkdir -p "$DATA_DIR"
  [[ ! -f "$DB_FILE" ]] && touch "$DB_FILE" || true

  for cmd in fzf git; do
    if ! command -v "$cmd" &>/dev/null; then
      log_err "Missing dependency: $cmd"
      exit 1
    fi
  done

  if ! command -v "$editor" &>/dev/null; then
    log_err "Missing dependency: $editor"
    exit 1
  fi
}

ensure_db() {
  mkdir -p "$DATA_DIR"
  [[ ! -f "$DB_FILE" ]] && touch "$DB_FILE" || true
}

# --- SESSION LAUNCH ---

# Print available layout profile names for a project (one per line).
# Returns 0 if any profiles exist, 1 otherwise.
list_project_profiles() {
  local project_root="$1"
  local profiles_dir="$project_root/config/profiles"
  local found=0
  local f

  if [[ ! -d "$profiles_dir" ]]; then
    return 1
  fi

  for f in "$profiles_dir"/*.kdl; do
    [[ -f "$f" ]] || continue
    basename "$f" .kdl
    found=1
  done

  [[ $found -eq 1 ]]
}

# Resolve zellij layout for a project.
# Prefer config/profiles/<name>.kdl when a profile is requested;
# otherwise fall back to config/hap.kdl.
# Prints the path on stdout. Returns 1 if a requested profile is missing.
resolve_layout_file() {
  local project_root="$1"
  local profile="${2:-}"
  local config_dir="$project_root/config"

  if [[ -n "$profile" ]]; then
    validate_name "$profile" profile || return 1
    [[ ! -L "$config_dir" && ! -L "$config_dir/profiles" ]] || return 1
    local candidate="$config_dir/profiles/${profile}.kdl"
    [[ ! -L "$candidate" ]] || { log_err "Refusing symlinked profile: $profile"; return 1; }
    if [[ ! -f "$candidate" ]]; then
      log_err "Profile not found: $profile"
      log_err "Expected: $candidate"
      if list_project_profiles "$project_root" >/dev/null; then
        log_err "Available profiles:"
        list_project_profiles "$project_root" | while IFS= read -r name; do
          log_err "  $name"
        done
      else
        log_err "No profiles found in $config_dir/profiles/"
      fi
      return 1
    fi
    echo "$candidate"
    return 0
  fi

  if [[ -f "$config_dir/hap.kdl" ]]; then
    echo "$config_dir/hap.kdl"
  fi
  return 0
}

launch_session() {
  local project_name="$1"
  local workspace_path="$2"
  local session_name="$3"
  local project_root="$4"
  local editor="${5:-zellij}"
  local profile="${6:-}"

  [[ ! -d "$workspace_path" ]] && {
    log_err "Path not found: $workspace_path"
    exit 1
  }

  cd "$workspace_path" || exit 1

  log_info "Launching $project_name with $editor..."

  case "$editor" in
  zellij)
    local layout_file=""
    if ! layout_file="$(resolve_layout_file "$project_root" "$profile")"; then
      exit 1
    fi

    if [[ -n "$profile" ]]; then
      log_info "Layout profile: $profile"
    fi

    # Prune Zellij session if it exists (Restart context)
    zellij delete-session "$session_name" 2>/dev/null || true

    local args=()
    [[ -n "$layout_file" ]] && args+=("--new-session-with-layout" "$layout_file") || true
    args+=("--session" "$session_name")

    unset ZELLIJ ZELLIJ_SESSION_NAME ZELLIJ_PANE_ID
    log_info "Command: zellij ${args[*]}"

    # HAP_UP controls whether server panes auto-run their start commands.
    # Only affects initial session creation — after that, manage servers
    # manually inside the running zellij session.
    if [[ "$START_UP" == "true" ]]; then
      export HAP_UP=1
    else
      unset HAP_UP
    fi

    # Run as subprocess (Blocking, but Zellij takes over terminal)
    env -u ZELLIJ -u ZELLIJ_SESSION_NAME -u ZELLIJ_PANE_ID zellij "${args[@]}" || true
    ;;
  cursor | antigravity)
    # Create Lock File (Prevents Bulk Cleanup)
    touch "$GUI_LOCK_FILE"

    log_info "Opening $editor..."
    # NO --wait. Fire and forget.
    if [[ "$editor" == "cursor" ]]; then
      cursor .
    else
      "$editor" .
    fi
    ;;
  *)
    log_err "Unsupported editor: $editor"
    exit 1
    ;;
  esac
}

# --- WORKSPACE ---

create_workspace() {
  local project_root="$1"
  local project_name="$2"
  local agent_task="$3"
  local base_branch="$4"
  local editor="${5:-zellij}"
  local target_branch_prefix="$6"
  local profile="${7:-}"

  local sources_dir="$project_root/sources"
  local target_ws="$project_root/workspaces/$agent_task"
  validate_workspace_path "$project_root" "$agent_task" || return 1

  if [[ -d "$target_ws" ]]; then
    log_warn "Resuming existing workspace: $agent_task"
  else
    log_info "Spawning workspace: $agent_task (base: $base_branch)"
    mkdir -p "$target_ws"

    for repo in "$sources_dir"/*; do
      local repo_name=$(basename "$repo")
      if [[ -d "$repo" && -d "$repo/.git" ]]; then
        local branch_name=""

        if [[ -n "$target_branch_prefix" ]]; then
          branch_name="${target_branch_prefix}"
        else
          branch_name="hap/${agent_task}"
        fi

        git -C "$repo" worktree prune

        if ! git -C "$repo" worktree add "$target_ws/$repo_name" -b "$branch_name" "$base_branch" 2>/dev/null; then
          git -C "$repo" worktree add "$target_ws/$repo_name" "$branch_name"
        fi

        git -C "$target_ws/$repo_name" push -u origin "$branch_name" 2>/dev/null || true

        # Shared State Linking
        if [[ -d "$project_root/shared/$repo_name" ]]; then
          log_info "Linking shared state for $repo_name..."
          (
            cd "$project_root/shared/$repo_name" || exit
            find . -type f | while read -r file; do
              local clean_file="${file#./}"
              local dest_file="$target_ws/$repo_name/$clean_file"
              local dest_dir=$(dirname "$dest_file")

              safe_destination "$target_ws/$repo_name" "$clean_file" || exit 1
              if [[ -e "$dest_file" ]]; then
                log_err "State destination already exists: $dest_file"
                exit 1
              fi
              mkdir -p "$dest_dir"

              local ups="../../../"
              local subdir=$(dirname "$clean_file")
              if [[ "$subdir" != "." ]]; then
                local sub_depth=$(echo "$subdir" | awk -F/ '{print NF}')
                for ((i = 0; i < sub_depth; i++)); do ups="../$ups"; done
              fi

              ln -s "${ups}shared/$repo_name/$clean_file" "$dest_file"
            done
          )
        fi

        if [[ -f "$target_ws/$repo_name/pnpm-lock.yaml" ]]; then
          (cd "$target_ws/$repo_name" && pnpm install --frozen-lockfile --silent &)
        elif [[ -f "$target_ws/$repo_name/go.mod" ]]; then
          (cd "$target_ws/$repo_name" && go mod download &)
        fi
      else
        log_info "Linking source: $repo_name"
        ln -sf "$repo" "$target_ws/$repo_name"
      fi
    done

    # Global Shared Linking
    if [[ -d "$project_root/shared" ]]; then
      for item in "$project_root/shared"/*; do
        local item_name=$(basename "$item")
        if [[ ! -e "$target_ws/$item_name" ]]; then
          log_info "Linking shared item: $item_name"
          ln -sf "$item" "$target_ws/$item_name"
        fi
      done
    fi

    wait
    log_succ "Workspace ready"
  fi

  local original_dir=$(pwd)
  cd "$target_ws" || exit 1
  launch_session "$project_name" "$target_ws" "$project_name-$agent_task" "$project_root" "$editor" "$profile"
  cd "$original_dir" || true
}

# --- INIT ---

hap_init() {
  local project_name="${1:-$(basename "$(pwd)")}"
  local project_root="$(pwd)"
  validate_name "$project_name" project || return 1

  # Guard: already initialized
  if [[ -d "$project_root/sources" ]]; then
    log_err "Already initialized (sources/ directory exists)"
    exit 1
  fi

  # Detect git repos
  local repos=()
  local is_root_repo=false

  # Level 0: is the current directory itself a git repo?
  if [[ -d "$project_root/.git" ]]; then
    is_root_repo=true
    repos+=("$project_name")
    log_info "Detected root-level repo: $project_name"
  else
    # Level 1: immediate subdirectories with .git
    for dir in "$project_root"/*/; do
      [[ ! -d "$dir" ]] && continue
      if [[ -d "$dir/.git" ]]; then
        local name
        name=$(basename "$dir")
        repos+=("$name")
        log_info "Detected repo: $name"
      fi
    done
  fi

  if [[ ${#repos[@]} -eq 0 ]]; then
    log_err "No git repositories found"
    log_err "Expected .git in current directory, or subdirectories containing .git"
    exit 1
  fi

  log_info "Initializing hap project: $project_name (${#repos[@]} repo(s))"

  # Create scaffold (4-Pillar Architecture)
  mkdir -p "$project_root/sources"
  mkdir -p "$project_root/workspaces/main"
  mkdir -p "$project_root/config"
  mkdir -p "$project_root/shared"
  mkdir -p "$project_root/data"

  # Track all extraction reports for final summary
  local all_extraction_reports=()

  if [[ "$is_root_repo" == true ]]; then
    # --- Single repo at root ---
    # Move everything into sources/<project_name>, then create a worktree back out.
    local staging="$project_root/.hap-init-staging"
    mkdir -p "$staging"

    # Move all contents to staging (visible + dotfiles, skip scaffold dirs)
    for item in "$project_root"/* "$project_root"/.[!.]*; do
      [[ ! -e "$item" ]] && continue
      local item_name
      item_name=$(basename "$item")
      case "$item_name" in
      sources | workspaces | config | shared | data | .hap-init-staging) continue ;;
      esac
      mv "$item" "$staging/" 2>/dev/null || true
    done

    # Staging becomes the source repo
    mv "$staging" "$project_root/sources/$project_name"

    # --- Extract state files (preserving monorepo paths) ---
    mkdir -p "$project_root/shared/$project_name"
    mkdir -p "$project_root/data/$project_name"

    local shared_files data_files
    shared_files=$(extract_shared_state "$project_root/sources/$project_name" "$project_root/shared/$project_name")
    data_files=$(extract_data_state "$project_root/sources/$project_name" "$project_root/data/$project_name")

    # Clean up empty extraction dirs
    rmdir "$project_root/shared/$project_name" 2>/dev/null || true
    rmdir "$project_root/data/$project_name" 2>/dev/null || true

    if [[ -n "$shared_files" || -n "$data_files" ]]; then
      all_extraction_reports+=("$project_name"$'\x1f'"$shared_files"$'\x1f'"$data_files")
    fi

    # Detach HEAD in source to free the branch name for the worktree
    local current_branch
    current_branch=$(git -C "$project_root/sources/$project_name" symbolic-ref --short HEAD 2>/dev/null || echo "")

    if [[ -n "$current_branch" ]]; then
      git -C "$project_root/sources/$project_name" checkout --detach 2>/dev/null
      git -C "$project_root/sources/$project_name" worktree add \
        "$project_root/workspaces/main/$project_name" "$current_branch" 2>/dev/null
      log_succ "Worktree: main/$project_name ($current_branch)"
    else
      log_warn "Could not determine branch for $project_name, skipping worktree"
    fi
  else
    # --- Multi-repo ---
    # Move each repo dir to sources/, create worktrees, collect leftovers.
    local misc_items=()

    for item in "$project_root"/*; do
      [[ ! -e "$item" ]] && continue
      local item_name
      item_name=$(basename "$item")

      # Skip scaffold dirs
      case "$item_name" in
      sources | workspaces | config | shared | data | misc) continue ;;
      esac

      if [[ -d "$item/.git" ]]; then
        # Git repo — move to sources
        mv "$item" "$project_root/sources/$item_name"

        # --- Extract state files (preserving monorepo paths) ---
        mkdir -p "$project_root/shared/$item_name"
        mkdir -p "$project_root/data/$item_name"

        local shared_files data_files
        shared_files=$(extract_shared_state "$project_root/sources/$item_name" "$project_root/shared/$item_name")
        data_files=$(extract_data_state "$project_root/sources/$item_name" "$project_root/data/$item_name")

        # Clean up empty extraction dirs
        rmdir "$project_root/shared/$item_name" 2>/dev/null || true
        rmdir "$project_root/data/$item_name" 2>/dev/null || true

        if [[ -n "$shared_files" || -n "$data_files" ]]; then
          all_extraction_reports+=("$item_name"$'\x1f'"$shared_files"$'\x1f'"$data_files")
        fi

        local current_branch
        current_branch=$(git -C "$project_root/sources/$item_name" symbolic-ref --short HEAD 2>/dev/null || echo "")

        if [[ -n "$current_branch" ]]; then
          git -C "$project_root/sources/$item_name" checkout --detach 2>/dev/null
          git -C "$project_root/sources/$item_name" worktree add \
            "$project_root/workspaces/main/$item_name" "$current_branch" 2>/dev/null
          log_succ "Worktree: main/$item_name ($current_branch)"
        else
          log_warn "Could not determine branch for $item_name, skipping worktree"
        fi
      else
        misc_items+=("$item")
      fi
    done

    # Collect dotfiles as misc too
    for item in "$project_root"/.[!.]*; do
      [[ ! -e "$item" ]] && continue
      misc_items+=("$item")
    done

    # Move leftovers to misc/
    if [[ ${#misc_items[@]} -gt 0 ]]; then
      mkdir -p "$project_root/misc"
      for item in "${misc_items[@]}"; do
        mv "$item" "$project_root/misc/" 2>/dev/null || true
      done
      log_info "Moved ${#misc_items[@]} non-repo item(s) to misc/"
    fi
  fi

  # Copy layout template to config/
  local script_dir
  script_dir="$(cd "$(dirname "$0")" && pwd -P)"
  local hap_root
  hap_root="$(dirname "$script_dir")"
  local template="$hap_root/templates/hap.kdl"

  if [[ -f "$template" ]]; then
    cp "$template" "$project_root/config/hap.kdl"
    log_succ "Copied layout template to config/hap.kdl"
  elif [[ -f "$DATA_DIR/templates/hap.kdl" ]]; then
    cp "$DATA_DIR/templates/hap.kdl" "$project_root/config/hap.kdl"
    log_succ "Copied layout template to config/hap.kdl"
  else
    log_warn "Layout template not found — copy templates/hap.kdl to config/hap.kdl manually"
  fi

  # Register project (upsert)
  mkdir -p "$DATA_DIR"
  [[ ! -f "$DB_FILE" ]] && touch "$DB_FILE"
  if grep -q "^${project_name}|" "$DB_FILE" 2>/dev/null; then
    local tmp_db
    tmp_db=$(mktemp)
    grep -v "^${project_name}|" "$DB_FILE" >"$tmp_db"
    mv "$tmp_db" "$DB_FILE"
  fi
  echo "${project_name}|${project_root}" >>"$DB_FILE"

  # --- Print state extraction summaries ---
  for report in "${all_extraction_reports[@]}"; do
    local r_name r_shared r_data
    IFS=$'\x1f' read -r r_name r_shared r_data <<<"$report"
    print_state_extraction_summary "$r_name" "$r_shared" "$r_data" "$project_root"
  done

  echo ""
  log_succ "Project initialized: $project_name"
  log_info "Next steps:"
  log_info "  1. Edit config/hap.kdl — set cwd paths and server commands"
  if [[ ${#all_extraction_reports[@]} -gt 0 ]]; then
    log_info "  2. Update .env files in shared/ to point to new data/ paths"
    log_info "  3. Run: hap open $project_name"
  else
    log_info "  2. Run: hap open $project_name"
  fi
}

# --- COMMANDS ---

hap_open() {
  local project="" workspace="" editor="zellij" base_branch="dev" target_branch="" profile=""
  local list_profiles=false
  START_UP="false"

  while [[ $# -gt 0 ]]; do
    case "$1" in
    -u)
      START_UP="true"
      shift
      ;;
    -e)
      editor="${2:?'-e requires an editor name'}"
      shift 2
      ;;
    -b)
      base_branch="${2:?'-b requires a branch name'}"
      shift 2
      ;;
    -B)
      target_branch="${2:?'-B requires a branch name'}"
      shift 2
      ;;
    -p | --profile)
      # Missing or incomplete value → list profiles after project is known
      if [[ -z "${2:-}" || "$2" == -* ]]; then
        list_profiles=true
        shift
      else
        profile="$2"
        shift 2
      fi
      ;;
    -*)
      log_err "Unknown option: $1"
      log_err "Usage: hap open <project> [workspace] [-u] [-p profile] [-e editor] [-b branch] [-B branch]"
      exit 1
      ;;
    *)
      if [[ -z "$project" ]]; then
        project="$1"
      elif [[ -z "$workspace" ]]; then
        workspace="$1"
      else
        log_err "Unexpected argument: $1"
        exit 1
      fi
      shift
      ;;
    esac
  done

  if [[ -z "$project" ]]; then
    log_err "Project name required"
    log_err "Usage: hap open <project> [workspace] [-u] [-p profile] [-e editor]"
    exit 1
  fi

  ensure_setup "$editor"

  validate_name "$project" project || return 1

  local path_to_root
  path_to_root=$(grep "^${project}|" "$DB_FILE" | cut -d '|' -f 2 || true)
  if [[ -z "$path_to_root" ]]; then
    log_err "Project not found: $project"
    exit 1
  fi

  validate_project_root "$path_to_root" || return 1

  if [[ "$list_profiles" == true ]]; then
    if list_project_profiles "$path_to_root"; then
      exit 0
    fi
    log_err "No profiles found in $path_to_root/config/profiles/"
    exit 1
  fi

  # Fail fast on bad / incomplete profile before touching sessions/workspaces
  if [[ -n "$profile" ]]; then
    resolve_layout_file "$path_to_root" "$profile" >/dev/null || exit 1
  fi

  if [[ -n "$workspace" ]]; then
    create_workspace "$path_to_root" "$project" "$workspace" "$base_branch" "$editor" "$target_branch" "$profile"
  else
    launch_session "$project" "$path_to_root/workspaces/main" "$project-main" "$path_to_root" "$editor" "$profile"
  fi
}

hap_add() {
  local name="${1:?'Project name required. Usage: hap add <name> [path]'}"
  local path="${2:-.}"
  validate_name "$name" project || return 1

  ensure_db

  local full_path
  [[ "$path" == "." ]] && full_path="$(pwd)" || full_path="$(cd "$path" && pwd)"

  # Upsert: remove old entry if exists
  if grep -q "^${name}|" "$DB_FILE" 2>/dev/null; then
    local tmp_db
    tmp_db=$(mktemp)
    grep -v "^${name}|" "$DB_FILE" >"$tmp_db"
    mv "$tmp_db" "$DB_FILE"
  fi

  echo "$name|$full_path" >>"$DB_FILE"
  log_succ "Registered: $name → $full_path"
}

hap_remove() {
  local name="${1:?'Project name required. Usage: hap remove <name>'}"
  validate_name "$name" project || return 1

  ensure_db

  if ! grep -q "^${name}|" "$DB_FILE" 2>/dev/null; then
    log_err "Project not found: $name"
    exit 1
  fi

  local tmp_db
  tmp_db=$(mktemp)
  grep -v "^${name}|" "$DB_FILE" >"$tmp_db"
  mv "$tmp_db" "$DB_FILE"
  log_succ "Removed: $name"
}

hap_clean() {
  local project="" workspace=""
  DELETE_REMOTE="false"
  CONFIRM_YES="false"

  while [[ $# -gt 0 ]]; do
    case "$1" in
    -D)
      DELETE_REMOTE="true"
      shift
      ;;
    -y)
      CONFIRM_YES="true"
      shift
      ;;
    -*)
      log_err "Unknown option: $1"
      log_err "Usage: hap clean <project> [workspace] [-D] [-y]"
      exit 1
      ;;
    *)
      if [[ -z "$project" ]]; then
        project="$1"
      elif [[ -z "$workspace" ]]; then
        workspace="$1"
      else
        log_err "Unexpected argument: $1"
        exit 1
      fi
      shift
      ;;
    esac
  done

  if [[ -z "$project" ]]; then
    log_err "Project name required"
    log_err "Usage: hap clean <project> [workspace] [-D] [-y]"
    exit 1
  fi

  validate_name "$project" project || return 1
  ensure_db

  local path_to_root
  path_to_root=$(grep "^${project}|" "$DB_FILE" | cut -d '|' -f 2 || true)
  if [[ -z "$path_to_root" ]]; then
    log_err "Project not found: $project"
    exit 1
  fi

  cleanup_project_workspaces "$path_to_root" "$workspace" "$project"
}

hap_list() {
  ensure_db
  if [[ ! -s "$DB_FILE" ]]; then
    log_warn "No projects registered. Use 'hap init' to get started."
    exit 0
  fi
  column -t -s "|" "$DB_FILE"
}

hap_interactive() {
  ensure_setup "zellij"
  START_UP="false"

  if [[ ! -s "$DB_FILE" ]]; then
    log_warn "No projects found. Use 'hap init' in your project directory."
    exit 0
  fi

  local selection
  selection=$(fzf --height=40% --layout=reverse --border --prompt="Select project > " --delimiter="|" --with-nth=1,2 <"$DB_FILE")
  if [[ -n "$selection" ]]; then
    local name path_to_root
    name=$(echo "$selection" | cut -d '|' -f 1)
    path_to_root=$(echo "$selection" | cut -d '|' -f 2)
    launch_session "$name" "$path_to_root/workspaces/main" "$name-main" "$path_to_root" "zellij"
  fi
}

# --- CLI ---

usage() {
  cat <<EOF
Usage: hap <command> [args] [flags]

Commands:
  init [name]                    Scaffold project from current directory
  open <project> [workspace]     Open project or workspace
  add <name> [path]              Register a project
  remove <name>                  Unregister a project
  clean <project> [workspace]    Cleanup workspace(s)
  list                           List registered projects
  help                           Show this help
  version                        Show version

Flags for 'open':
  -u              Auto-start servers (like docker compose up)
  -p, --profile   Layout profile from config/profiles/<name>.kdl
                  Omit the name (hap open <project> -p) to list profiles
  -e <editor>     Editor: zellij (default), cursor, antigravity
  -b <branch>     Base branch for new workspace (default: dev)
  -B <branch>     Target branch name (default: hap/<workspace>)

Flags for 'clean':
  -D              Also delete remote branches
  -y              Skip confirmation (with -D)

Run 'hap' with no arguments for interactive project selection.
EOF
}

# --- MAIN ---

case "${1:-}" in
init)
  shift
  hap_init "$@"
  ;;
open)
  shift
  hap_open "$@"
  ;;
add)
  shift
  hap_add "$@"
  ;;
remove)
  shift
  hap_remove "$@"
  ;;
clean)
  shift
  hap_clean "$@"
  ;;
list) hap_list ;;
version | -v | --version) echo "hap v$VERSION" ;;
help | -h | --help) usage ;;
"") hap_interactive ;;
*)
  log_err "Unknown command: $1"
  echo ""
  usage
  exit 1
  ;;
esac
