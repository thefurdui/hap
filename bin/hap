#!/usr/bin/env bash

# hap
# https://github.com/thefurdui/hap
# License: MIT

set -e

# --- CONFIG ---
APP_NAME="hap"
VERSION="1.1.0"
XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
DATA_DIR="$XDG_DATA_HOME/$APP_NAME"
DB_FILE="$DATA_DIR/projects.csv"

# Lock file for GUI workspaces
GUI_LOCK_FILE=".hap.gui"

# --- COLORS ---
BLUE='\033[0;34m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

log_info() { echo -e "${BLUE}INFO:${NC} $1"; }
log_succ() { echo -e "${GREEN}OK:${NC}   $1"; }
log_warn() { echo -e "${YELLOW}WARN:${NC} $1"; }
log_err() { echo -e "${RED}ERR:${NC}  $1" >&2; }

# --- HELPERS ---

validate_name() {
  [[ "$1" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]] && return 0
  log_err "Invalid $2: $1 (use letters, digits, dots, underscores, or hyphens)"
  return 1
}

validate_project_root() {
  local root="$1" part
  [[ "$root" == /* && -d "$root" ]] || { log_err "Invalid project root: $root"; return 1; }
  for part in sources workspaces shared data config; do
    [[ ! -L "$root/$part" ]] || { log_err "Refusing symlinked project directory: $part"; return 1; }
  done
}

validate_workspace_path() {
  local root="$1" name="$2"
  validate_name "$name" workspace || return 1
  validate_project_root "$root" || return 1
  [[ ! -L "$root/workspaces/$name" ]] || { log_err "Refusing symlinked workspace: $name"; return 1; }
}

# A checked-out branch may contain symlinks. Never follow them while provisioning.
safe_destination() {
  local root="$1" relative="$2" component current="$1"
  local -a components
  [[ -d "$root" && ! -L "$root" && "$relative" != /* ]] || return 1
  IFS=/ read -r -a components <<<"$relative"
  for component in "${components[@]}"; do
    case "$component" in ''|.|..|.git) log_err "Unsafe state path: $relative"; return 1 ;; esac
    current="$current/$component"
    if [[ -L "$current" ]]; then
      log_err "Refusing symlink in state destination: $current"
      return 1
    fi
  done
}

ignore_generated_path() {
  local repo="$1" relative="$2" exclude pattern
  [[ "$relative" != *$'\n'* && "$relative" != *$'\r'* ]] || {
    log_err "State paths cannot contain line breaks: $relative"; return 1;
  }
  if git -C "$repo" ls-files --error-unmatch -- "$relative" >/dev/null 2>&1; then
    log_err "Refusing to replace tracked state: $relative"
    return 1
  fi
  exclude=$(git -C "$repo" rev-parse --path-format=absolute --git-path info/exclude) || return 1
  [[ ! -L "$exclude" ]] || return 1
  pattern="${relative//\\/\\\\}"
  pattern="${pattern//\*/\\*}"; pattern="${pattern//\?/\\?}"
  pattern="${pattern//\[/\\[}"; pattern="${pattern//\]/\\]}"
  pattern="${pattern// /\\ }"
  mkdir -p "${exclude%/*}" || return 1
  grep -Fxq -- "/$pattern" "$exclude" 2>/dev/null || printf '\n/%s\n' "$pattern" >> "$exclude"
}

# Directories to exclude when scanning for state files
STATE_EXCLUDE_DIRS="node_modules vendor .git dist build"

# Build find exclusion arguments from the directory list
_build_find_excludes() {
  local args=()
  local first=true
  for dir in $STATE_EXCLUDE_DIRS; do
    if [[ "$first" == true ]]; then
      args+=("-name" "$dir")
      first=false
    else
      args+=("-o" "-name" "$dir")
    fi
  done
  # Return: \( -name node_modules -o -name vendor ... \) -prune
  echo "(" "${args[@]}" ")" "-prune"
}

# Extract shared config files (.env, .pem, .crt, .key) preserving directory structure.
# Args: <repo_source_path> <shared_dest_dir>
# Populates the global SHARED_MOVED array with "<relative_path>" entries.
SHARED_MOVED=()
extract_shared_state() {
  local repo_path="$1"
  local dest_dir="$2"

  SHARED_MOVED=()
  (
    cd "$repo_path" || return
    # Find config files, excluding build/vendor dirs
    find . \( -name node_modules -o -name vendor -o -name .git -o -name dist -o -name build \) -prune \
      -o \( -name '.env' -o -name '.env.*' -o -name '*.pem' -o -name '*.crt' -o -name '*.key' \) -type f -print
  ) | while IFS= read -r file; do
    local clean_file="${file#./}"
    git -C "$repo_path" check-ignore --quiet -- "$clean_file" || continue
    local dest_file="$dest_dir/$clean_file"
    init_mkdir "$(dirname "$dest_file")" || return 1
    init_move "$repo_path/$clean_file" "$dest_file" || return 1
    echo "$clean_file"
  done
}

# Extract mutating data files (.db, .sqlite, .log, WAL) preserving directory structure.
# Args: <repo_source_path> <data_dest_dir>
# Outputs moved file paths to stdout (one per line).
extract_data_state() {
  local repo_path="$1"
  local dest_dir="$2"

  (
    cd "$repo_path" || return
    find . \( -name node_modules -o -name vendor -o -name .git -o -name dist -o -name build \) -prune \
      -o \( -name '*.db' -o -name '*.sqlite' -o -name '*.sqlite3' \
      -o -name '*.db-wal' -o -name '*.sqlite-wal' -o -name '*.sqlite3-wal' \
      -o -name '*.db-shm' -o -name '*.sqlite-shm' -o -name '*.sqlite3-shm' \
      -o -name '*.db-journal' -o -name '*.sqlite-journal' -o -name '*.sqlite3-journal' -o -name '*.log' \) -type f -print
  ) | while IFS= read -r file; do
    local clean_file="${file#./}"
    git -C "$repo_path" check-ignore --quiet -- "$clean_file" || continue
    local dest_file="$dest_dir/$clean_file"
    init_mkdir "$(dirname "$dest_file")" || return 1
    init_move "$repo_path/$clean_file" "$dest_file" || return 1
    echo "$clean_file"
  done
}

# Print a highly visible summary block of what was moved during init.
# Args: <repo_name> <shared_files_string> <data_files_string> <project_root>
print_state_extraction_summary() {
  local repo_name="$1" shared_files="$2" data_files="$3" root="$4" file
  while IFS= read -r file; do
    [[ -n "$file" ]] || continue
    printf 'Config: %s -> %s/shared/%s/%s\n' "$file" "$root" "$repo_name" "$file"
  done <<< "$shared_files"
  while IFS= read -r file; do
    [[ -n "$file" ]] || continue
    printf 'Data: %s -> %s/data/workspaces/main/%s/%s\n' "$file" "$root" "$repo_name" "$file"
  done <<< "$data_files"
  if [[ -n "$data_files" ]]; then
    log_info "Configure database paths explicitly; relative paths depend on your application, not the env file location."
  fi
}

# Return 0 for active/resumable, 1 for absent, 2 for unknown. Unknown is unsafe.
zellij_session_exists() {
  local session_name="$1" sessions
  if ! command -v zellij >/dev/null 2>&1; then
    log_err "Cannot determine session activity: zellij is unavailable"
    return 2
  fi
  if ! sessions=$(zellij list-sessions --short --no-formatting); then
    log_err "Cannot determine session activity"
    return 2
  fi
  grep -Fxq -- "$session_name" <<<"$sessions"
}

workspace_is_active() {
  local project_name="$1" ws_path="$2"
  [[ ! -e "$ws_path/$GUI_LOCK_FILE" && ! -e "$ws_path/.hap-opening" ]] || return 0
  zellij_session_exists "$project_name-${ws_path##*/}"
}

branch_is_protected() {
  local source="$1" branch="$2" default_ref configured
  case "$branch" in main|master|dev|develop|trunk|stable|release|release/*) return 0 ;; esac
  default_ref=$(git -C "$source" symbolic-ref --quiet refs/remotes/origin/HEAD) || default_ref=""
  [[ -n "$default_ref" && "$branch" == "${default_ref#refs/remotes/origin/}" ]] && return 0
  configured=$(git -C "$source" config --get hap.baseBranch) || configured=""
  [[ -n "$configured" && "$branch" == "${configured#refs/heads/}" ]] && return 0
  while IFS= read -r configured; do
    [[ -n "$configured" && "$branch" == "$configured" ]] && return 0
  done < <(git -C "$source" config --get-all hap.protectedBranch)
  return 1
}

# --- CLEANUP FUNCTIONS ---

cleanup_workspace() {
  local ws_path="$1" sources_dir="$2" delete_remote="${4:-false}"
  local repo source_repo repo_name status tip branch common git_dir remote_tip ignored manifest path kind value
  local -a repos=() branches=() tips=()
  [[ -d "$ws_path" ]] || { log_err "Workspace not found: $ws_path"; return 1; }

  # Inventory every entry, including ignored files and workspace-level notes.
  # Unknown contents are never disposable merely because Git cannot see them.
  for repo in "$ws_path"/* "$ws_path"/.[!.]* "$ws_path"/..?*; do
    [[ -e "$repo" || -L "$repo" ]] || continue
    [[ "$repo" == "$ws_path/$GUI_LOCK_FILE" && -f "$repo" && ! -L "$repo" ]] && continue
    [[ "$repo" == "$ws_path/.hap-ready" && -f "$repo" && ! -L "$repo" ]] && continue
    [[ "$repo" == "$ws_path/.hap-state" && -d "$repo" && ! -L "$repo" ]] && continue
    repo_name="${repo##*/}"
    source_repo="$sources_dir/$repo_name"
    if [[ -L "$repo" || ! -f "$repo/.git" || -L "$repo/.git" || -L "$source_repo" || ! -d "$source_repo/.git" ]]; then
      log_err "Preserving unknown workspace entry: $repo"
      return 1
    fi
    common=$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir) || return 1
    [[ "$common" == "$(cd "$source_repo/.git" && pwd -P)" ]] || { log_err "Worktree belongs to another source: $repo"; return 1; }
    git_dir=$(git -C "$repo" rev-parse --absolute-git-dir) || return 1
    [[ ! -e "$git_dir/locked" ]] || { log_err "Worktree is locked: $repo"; return 1; }
    status=$(git -C "$repo" status --porcelain --untracked-files=all) || {
      log_err "Cannot inspect $repo"; return 1;
    }
    [[ -z "$status" ]] || { log_warn "Preserving $repo — local or ignored files present"; return 1; }
    manifest="$ws_path/.hap-state/$repo_name"
    check_managed_state "$repo" "$manifest" || return 1
    while IFS= read -r -d '' ignored; do
      managed_lookup "$manifest" "$ignored" || { log_err "Preserving ignored file: $repo/$ignored"; return 1; }
      managed_matches "$repo" "$ignored" "$MANAGED_KIND" "$MANAGED_VALUE" || return 1
    done < <(git -C "$repo" ls-files --others --ignored --exclude-standard -z)
    tip=$(git -C "$repo" rev-parse --verify HEAD) || return 1
    branch=$(git -C "$repo" symbolic-ref --quiet --short HEAD) || branch=""
    if [[ -n "$branch" ]] && branch_is_protected "$source_repo" "$branch"; then
      log_err "Preserving protected branch: $branch"
      return 1
    fi
    if [[ "$delete_remote" == true && -n "$branch" ]]; then
      remote_tip=$(git -C "$repo" ls-remote --exit-code --heads origin "refs/heads/$branch") || {
        log_err "Cannot verify remote branch: $branch"; return 1;
      }
      remote_tip="${remote_tip%%$'\t'*}"
      [[ "$remote_tip" == "$tip" ]] || { log_err "Remote branch differs from local history: $branch"; return 1; }
    fi
    repos+=("$repo")
    branches+=("$branch")
    tips+=("$tip")
  done

  local i recovery
  for ((i = 0; i < ${#repos[@]}; i++)); do
    repo="${repos[i]}"
    source_repo="$sources_dir/${repo##*/}"
    if [[ -z "${branches[i]}" ]]; then
      recovery="refs/hap/recovery/${ws_path##*/}/${repo##*/}-${tips[i]}"
      git -C "$repo" update-ref "$recovery" "${tips[i]}" || return 1
      log_info "Preserved detached history at $recovery"
    fi
    remove_managed_state "$repo" "$ws_path/.hap-state/${repo##*/}" || return 1
    # Never replace Git's refusal with recursive filesystem deletion.
    git -C "$source_repo" worktree remove "$repo" || return 1
    rm -f "$ws_path/.hap-state/${repo##*/}" || return 1
    if [[ "$delete_remote" == true && -n "${branches[i]}" ]]; then
      branch="${branches[i]}"
      git -C "$source_repo" push --force-with-lease="refs/heads/$branch:${tips[i]}" origin ":refs/heads/$branch" || return 1
    fi
  done
  [[ ! -d "$ws_path/.hap-state" ]] || rmdir "$ws_path/.hap-state" || return 1
  rm -f "$ws_path/$GUI_LOCK_FILE" "$ws_path/.hap-ready" || return 1
  rmdir "$ws_path" || return 1
}

cleanup_project_workspaces() {
  local project_root="$1"
  local task="$2"
  local project_name="$3"
  local failures=0
  local sources_dir="$project_root/sources"
  local workspaces_dir="$project_root/workspaces"
  validate_project_root "$project_root" || return 1

  [[ ! -d "$workspaces_dir" ]] && return

  # Confirmation for Remote Delete
  if [[ "$DELETE_REMOTE" == "true" && "$CONFIRM_YES" != "true" ]]; then
    echo -n "WARNING: You are about to delete REMOTE branches. This cannot be undone. Continue? [y/N] "
    read -r response
    if [[ ! "$response" =~ ^[yY]$ ]]; then
      log_warn "Aborted by user."
      return
    fi
  fi

  local delete_local="false"
  local delete_remote="$DELETE_REMOTE"

  if [[ -n "$task" ]]; then
    validate_workspace_path "$project_root" "$task" || return 1
    [[ "$task" != main ]] || { log_err "The main workspace is protected"; return 1; }
    local ws_path="$workspaces_dir/$task"
    if workspace_is_active "$project_name" "$ws_path"; then
      log_err "Workspace is active or resumable: $task"
      return 1
    else
      [[ $? -eq 1 ]] || return 1
    fi
    log_info "Cleaning workspace: $task"
    if cleanup_workspace "$ws_path" "$sources_dir" "$delete_local" "$delete_remote"; then
      log_succ "Cleaned: $task"
    else
      log_warn "Failed to clean: $task (maybe uncommitted changes?)"
      return 1
    fi
  else
    # BULK CLEANUP: SAFETY IS PARAMOUNT
    log_info "Running bulk cleanup for inactive workspaces..."
    for ws_path in "$workspaces_dir"/*; do
      [[ ! -d "$ws_path" ]] && continue
      local ws_name=$(basename "$ws_path")
      validate_workspace_path "$project_root" "$ws_name" || return 1
      [[ "$ws_name" == "main" ]] && continue

      local activity
      if workspace_is_active "$project_name" "$ws_path"; then
        log_info "Preserving active or resumable workspace: $ws_name"
        continue
      else
        activity=$?
        [[ $activity -eq 1 ]] || return 1
      fi

      if cleanup_workspace "$ws_path" "$sources_dir" "$delete_local" "$delete_remote"; then
        log_succ "Cleaned: $ws_name"
      else
        failures=1
      fi
    done
  fi
  return "$failures"
}

# --- SETUP ---

ensure_setup() {
  local editor="${1:-zellij}"
  mkdir -p "$DATA_DIR"
  [[ ! -f "$DB_FILE" ]] && touch "$DB_FILE" || true

  for cmd in fzf git; do
    if ! command -v "$cmd" &>/dev/null; then
      log_err "Missing dependency: $cmd"
      exit 1
    fi
  done

  if ! command -v "$editor" &>/dev/null; then
    log_err "Missing dependency: $editor"
    exit 1
  fi
}

ensure_db() {
  mkdir -p "$DATA_DIR"
  [[ ! -f "$DB_FILE" ]] && touch "$DB_FILE" || true
}

# --- SESSION LAUNCH ---

# Print available layout profile names for a project (one per line).
# Returns 0 if any profiles exist, 1 otherwise.
list_project_profiles() {
  local project_root="$1"
  local profiles_dir="$project_root/config/profiles"
  local found=0
  local f

  if [[ ! -d "$profiles_dir" ]]; then
    return 1
  fi

  for f in "$profiles_dir"/*.kdl; do
    [[ -f "$f" ]] || continue
    basename "$f" .kdl
    found=1
  done

  [[ $found -eq 1 ]]
}

# Resolve zellij layout for a project.
# Prefer config/profiles/<name>.kdl when a profile is requested;
# otherwise fall back to config/hap.kdl.
# Prints the path on stdout. Returns 1 if a requested profile is missing.
resolve_layout_file() {
  local project_root="$1"
  local profile="${2:-}"
  local config_dir="$project_root/config"

  if [[ -n "$profile" ]]; then
    validate_name "$profile" profile || return 1
    [[ ! -L "$config_dir" && ! -L "$config_dir/profiles" ]] || return 1
    local candidate="$config_dir/profiles/${profile}.kdl"
    [[ ! -L "$candidate" ]] || { log_err "Refusing symlinked profile: $profile"; return 1; }
    if [[ ! -f "$candidate" ]]; then
      log_err "Profile not found: $profile"
      log_err "Expected: $candidate"
      if list_project_profiles "$project_root" >/dev/null; then
        log_err "Available profiles:"
        list_project_profiles "$project_root" | while IFS= read -r name; do
          log_err "  $name"
        done
      else
        log_err "No profiles found in $config_dir/profiles/"
      fi
      return 1
    fi
    echo "$candidate"
    return 0
  fi

  if [[ -f "$config_dir/hap.kdl" ]]; then
    echo "$config_dir/hap.kdl"
  fi
  return 0
}

launch_session() {
  local project_name="$1"
  local workspace_path="$2"
  local session_name="$3"
  local project_root="$4"
  local editor="${5:-zellij}"
  local profile="${6:-}"

  [[ ! -d "$workspace_path" ]] && {
    log_err "Path not found: $workspace_path"
    exit 1
  }

  cd "$workspace_path" || exit 1
  HAP_DATA_DIR=$(workspace_data_path "$project_root" "${workspace_path##*/}") || return 1
  export HAP_DATA_DIR

  log_info "Launching $project_name with $editor..."

  case "$editor" in
  zellij)
    local layout_file=""
    if ! layout_file="$(resolve_layout_file "$project_root" "$profile")"; then
      exit 1
    fi

    if [[ -n "$profile" ]]; then
      log_info "Layout profile: $profile"
    fi

    # Prune Zellij session if it exists (Restart context)
    zellij delete-session "$session_name" 2>/dev/null || true

    local args=()
    [[ -n "$layout_file" ]] && args+=("--new-session-with-layout" "$layout_file") || true
    args+=("--session" "$session_name")

    unset ZELLIJ ZELLIJ_SESSION_NAME ZELLIJ_PANE_ID
    log_info "Command: zellij ${args[*]}"

    # HAP_UP controls whether server panes auto-run their start commands.
    # Only affects initial session creation — after that, manage servers
    # manually inside the running zellij session.
    if [[ "$START_UP" == "true" ]]; then
      export HAP_UP=1
    else
      unset HAP_UP
    fi

    # Run as subprocess (Blocking, but Zellij takes over terminal)
    env -u ZELLIJ -u ZELLIJ_SESSION_NAME -u ZELLIJ_PANE_ID zellij "${args[@]}" || return 1
    ;;
  cursor | antigravity)
    # Create Lock File (Prevents Bulk Cleanup)
    touch "$GUI_LOCK_FILE"

    log_info "Opening $editor..."
    # NO --wait. Fire and forget.
    if [[ "$editor" == "cursor" ]]; then
      cursor .
    else
      "$editor" .
    fi
    ;;
  *)
    log_err "Unsupported editor: $editor"
    exit 1
    ;;
  esac
}

# --- WORKSPACE ---

managed_lookup() {
  local manifest="$1" wanted="$2" path kind value
  MANAGED_KIND=""; MANAGED_VALUE=""
  [[ -f "$manifest" && ! -L "$manifest" ]] || return 1
  while IFS= read -r -d '' path; do
    IFS= read -r -d '' kind || return 2
    IFS= read -r -d '' value || return 2
    if [[ "$path" == "$wanted" ]]; then
      MANAGED_KIND="$kind"; MANAGED_VALUE="$value"
      return 0
    fi
  done < "$manifest"
  return 1
}

managed_matches() {
  local work="$1" path="$2" kind="$3" value="$4" parent
  parent=$(dirname "$path") || return 1
  [[ "$parent" == . ]] || safe_destination "$work" "$parent" || return 1
  case "$kind" in
    C)
      safe_destination "$work" "$path" || return 1
      [[ -f "$work/$path" && "$(git -C "$work" hash-object --no-filters -- "$work/$path")" == "$value" ]]
      ;;
    L) [[ -L "$work/$path" && "$(readlink "$work/$path")" == "$value" ]] ;;
    *) return 1 ;;
  esac
}

check_managed_state() {
  local work="$1" manifest="$2" path kind value
  [[ -f "$manifest" && ! -L "$manifest" ]] || return 0
  while IFS= read -r -d '' path; do
    IFS= read -r -d '' kind || return 1
    IFS= read -r -d '' value || return 1
    [[ -e "$work/$path" || -L "$work/$path" ]] || continue
    managed_matches "$work" "$path" "$kind" "$value" || {
      log_err "Preserving edited generated state: $work/$path"; return 1;
    }
    if git -C "$work" ls-files --error-unmatch -- "$path" >/dev/null 2>&1; then
      log_err "Generated path is now tracked: $work/$path"; return 1
    fi
  done < "$manifest"
}

remove_managed_state() {
  local work="$1" manifest="$2" path kind value
  [[ -f "$manifest" && ! -L "$manifest" ]] || return 0
  while IFS= read -r -d '' path; do
    IFS= read -r -d '' kind || return 1
    IFS= read -r -d '' value || return 1
    if [[ -e "$work/$path" || -L "$work/$path" ]]; then
      managed_matches "$work" "$path" "$kind" "$value" || return 1
      rm "$work/$path" || return 1
    fi
  done < "$manifest"
}

setup_workspace_repo() {
  local project_root="$1" target_ws="$2" repo_name="$3"
  local work="$target_ws/$repo_name" shared="$project_root/shared/$repo_name"
  local metadata="$target_ws/.hap-state" manifest="$target_ws/.hap-state/$repo_name"
  local data_path
  data_path=$(workspace_data_path "$project_root" "${target_ws##*/}") || return 1
  safe_destination "$project_root" "${data_path#"$project_root"/}/$repo_name" || return 1
  if [[ -n "${INIT_JOURNAL:-}" ]]; then init_mkdir "$data_path/$repo_name" || return 1; else mkdir -p "$data_path/$repo_name" || return 1; fi
  [[ ! -L "$metadata" && ! -L "$manifest" ]] || { log_err "Unsafe generated-state metadata"; return 1; }
  if [[ -n "${INIT_JOURNAL:-}" ]]; then init_mkdir "$metadata" || return 1; else mkdir -p "$metadata" || return 1; fi
  chmod 700 "$metadata" || return 1
  if [[ -d "$shared" ]]; then
    [[ ! -L "$shared" ]] || { log_err "Shared repository directory is a symlink: $shared"; return 1; }
    (
      umask 077
      cd "$shared" || exit 1
      find . -type f | while IFS= read -r file; do
        local clean_file="${file#./}" ups="../../../" subdir kind value lookup
        local dest="$work/$clean_file"
        subdir=$(dirname "$clean_file")
        if [[ "$subdir" != . ]]; then
          safe_destination "$work" "$subdir" || exit 1
          local depth
          depth=$(awk -F/ '{print NF}' <<< "$subdir")
          for ((i=0; i<depth; i++)); do ups="../$ups"; done
        fi
        if managed_lookup "$manifest" "$clean_file"; then
          # Keep local edits and deletions; opening is not a refresh operation.
          continue
        else
          lookup=$?
          [[ $lookup -eq 1 ]] || exit 1
        fi
        local legacy=false
        if [[ -L "$dest" && "$(readlink "$dest")" == "${ups}shared/$repo_name/$clean_file" ]]; then
          legacy=true
        else
          safe_destination "$work" "$clean_file" || exit 1
          [[ ! -e "$dest" ]] || { log_err "State destination exists: $dest"; exit 1; }
        fi
        ignore_generated_path "$work" "$clean_file" || exit 1
        if [[ -n "${INIT_JOURNAL:-}" ]]; then init_mkdir "${dest%/*}" || exit 1; else mkdir -p "${dest%/*}" || exit 1; fi
        if [[ "${SHARED_CONFIG:-false}" == true ]]; then
          kind=L; value="${ups}shared/$repo_name/$clean_file"
          if [[ "$legacy" == false ]]; then
            [[ -z "${INIT_JOURNAL:-}" ]] || init_record L "$dest" "$value" || exit 1
            ln -s "$value" "$dest" || exit 1
          fi
        else
          kind=C
          value=$(git -C "$work" hash-object --no-filters -- "$shared/$clean_file") || exit 1
          [[ -z "${INIT_JOURNAL:-}" ]] || init_record C "$dest" "$value" || exit 1
          # A legacy link is unlinked, never followed by the copy.
          [[ "$legacy" == false ]] || rm "$dest" || exit 1
          cp "$shared/$clean_file" "$dest" || exit 1
          chmod 600 "$dest" || exit 1
        fi
        printf '%s\0%s\0%s\0' "$clean_file" "$kind" "$value" >> "$manifest" || exit 1
      done
    ) || return 1
  fi
  [[ "${INSTALL_DEPS:-false}" == true ]] || return 0
  if [[ -f "$work/pnpm-lock.yaml" ]]; then
    (cd "$work" && pnpm install --frozen-lockfile) || return 1
  elif [[ -f "$work/go.mod" ]]; then
    (cd "$work" && go mod download) || return 1
  fi
}

workspace_data_path() {
  local root="$1" workspace="$2" relative="data/workspaces/$2"
  [[ "${SHARED_DATA:-false}" != true ]] || relative="data/shared"
  validate_name "$workspace" workspace || return 1
  safe_destination "$root" "$relative" || return 1
  printf '%s/%s\n' "$root" "$relative"
}

with_project_lock() (
  local root="$1" lock="$1/.hap-lock"
  shift
  mkdir -m 700 "$lock" 2>/dev/null || {
    log_err "Project is busy; inspect $lock/owner if a previous process crashed"
    return 1
  }
  printf '%s\n' "$BASHPID" > "$lock/owner"
  trap 'rm -f "$lock/owner"; rmdir "$lock"' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  "$@"
)

discover_sources() {
  local root="$1" repo top
  SOURCE_REPOS=()
  [[ -d "$root/sources" && ! -L "$root/sources" ]] || { log_err "Missing sources directory"; return 1; }
  for repo in "$root/sources"/* "$root/sources"/.[!.]* "$root/sources"/..?*; do
    [[ -e "$repo" || -L "$repo" ]] || continue
    validate_name "${repo##*/}" repository || return 1
    [[ -d "$repo/.git" && ! -L "$repo" && ! -L "$repo/.git" ]] || {
      log_err "Source must be a regular Git checkout, not a symlink, bare repo, or linked worktree: $repo"
      return 1
    }
    top=$(git -C "$repo" rev-parse --show-toplevel) || return 1
    [[ "$top" == "$(cd "$repo" && pwd -P)" ]] || return 1
    git -C "$repo" rev-parse --verify HEAD >/dev/null || return 1
    SOURCE_REPOS+=("$repo")
  done
  [[ ${#SOURCE_REPOS[@]} -gt 0 ]] || { log_err "No source repositories found"; return 1; }
}

prepare_workspace() {
  local project_root="$1" project_name="$2" agent_task="$3" base_branch="$4"
  local editor="$5" target_branch="$6"
  local sources_dir="$project_root/sources" target_ws="$project_root/workspaces/$agent_task"
  local repo repo_name work branch_name common base_oid
  validate_workspace_path "$project_root" "$agent_task" || return 1
  discover_sources "$project_root" || return 1
  for meta in .hap-ready .hap-opening; do
    [[ ! -L "$target_ws/$meta" ]] || { log_err "Unsafe workspace metadata: $meta"; return 1; }
  done
  mkdir -p "$target_ws" || return 1
  rm -f "$target_ws/.hap-ready" || return 1
  for repo in "${SOURCE_REPOS[@]}"; do
    repo_name="${repo##*/}"
    work="$target_ws/$repo_name"
    if [[ -d "$repo/.git" && ! -L "$repo" ]]; then
      if [[ -e "$work/.git" && ! -L "$work" ]]; then
        common=$(git -C "$work" rev-parse --path-format=absolute --git-common-dir) || return 1
        [[ "$common" == "$(cd "$repo/.git" && pwd -P)" ]] || { log_err "Worktree belongs to another source: $work"; return 1; }
      else
        [[ ! -e "$work" && ! -L "$work" ]] || { log_err "Incomplete or unknown directory: $work"; return 1; }
        branch_name="${target_branch:-hap/$agent_task}"
        git check-ref-format --branch "$branch_name" >/dev/null || return 1
        if [[ "${FETCH_BASE:-false}" == true ]]; then git -C "$repo" fetch origin || return 1; fi
        if git -C "$repo" show-ref --verify --quiet "refs/heads/$branch_name"; then
          [[ "${REUSE_BRANCH:-false}" == true ]] || {
            log_err "Branch already exists: $branch_name (use --reuse-branch intentionally)"; return 1;
          }
          git -C "$repo" worktree add "$work" "$branch_name" || return 1
        else
          base_oid=$(resolve_base_commit "$repo" "$base_branch") || return 1
          git -C "$repo" worktree add "$work" -b "$branch_name" "$base_oid" || return 1
        fi
      fi
      setup_workspace_repo "$project_root" "$target_ws" "$repo_name" || return 1
      if [[ "${PUBLISH_BRANCH:-false}" == true ]]; then
        branch_name=$(git -C "$work" symbolic-ref --quiet --short HEAD) || {
          log_err "Cannot publish a detached worktree"; return 1;
        }
        git -C "$work" push -u origin "$branch_name" || return 1
      fi
    fi
  done
  printf '1\n' > "$target_ws/.hap-ready" || return 1
  # Reserve the workspace through session launch, closing the cleanup race.
  printf '%s\n' "$$" > "$target_ws/.hap-opening" || return 1
  log_succ "Workspace ready: $agent_task"
}

create_workspace() (
  local root="$1" name="$2" task="$3" editor="${5:-zellij}" profile="${7:-}"
  with_project_lock "$root" prepare_workspace "$@" || return 1
  local opening="$root/workspaces/$task/.hap-opening"
  trap 'rm -f "$opening"' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  launch_session "$name" "$root/workspaces/$task" "$name-$task" "$root" "$editor" "$profile"
)

resolve_base_commit() {
  local repo="$1" candidate="${2:-}"
  if [[ -z "$candidate" ]]; then candidate=$(git -C "$repo" config --get hap.baseBranch) || candidate=""; fi
  if [[ -z "$candidate" ]]; then candidate=$(git -C "$repo" symbolic-ref --quiet refs/remotes/origin/HEAD) || candidate=""; fi
  if [[ -z "$candidate" ]]; then candidate=$(git -C "$repo" symbolic-ref --quiet HEAD) || candidate=HEAD; fi
  git -C "$repo" rev-parse --verify --end-of-options "${candidate}^{commit}" || {
    log_err "Base does not resolve locally: $candidate (fetch explicitly or select -b)"; return 1;
  }
}

# --- INIT ---

# Journal each operation before attempting it. Recovery only removes empty
# directories or worktrees accepted by Git; conflicts stop without discarding data.
init_record() { printf '%s\0%s\0%s\0' "$1" "$2" "${3:-}" >> "$INIT_JOURNAL/operations"; }

init_mkdir() {
  [[ -d "$1" && ! -L "$1" ]] && return 0
  [[ ! -e "$1" && ! -L "$1" ]] || return 1
  init_mkdir "${1%/*}" || return 1
  init_record D "$1" || return 1
  mkdir "$1"
}

init_move() {
  [[ ! -e "$2" && ! -L "$2" ]] || { log_err "Migration destination exists: $2"; return 1; }
  init_record M "$1" "$2" || return 1
  mv "$1" "$2"
}

recover_init() {
  local root="$1" journal="$1/.hap-init-journal" kind from to i
  local -a kinds=() froms=() tos=()
  [[ -d "$journal" && ! -L "$journal" && -f "$journal/operations" ]] || return 1
  while IFS= read -r -d '' kind; do
    IFS= read -r -d '' from || return 1
    IFS= read -r -d '' to || return 1
    case "$kind" in M|D|W|H|L|C) ;; *) log_err "Invalid migration journal"; return 1 ;; esac
    for path in "$from" "$to"; do
      [[ -z "$path" ]] && continue
      if [[ "$path" == "$to" && ( "$kind" == H || "$kind" == L || "$kind" == C ) ]]; then
        [[ "$kind" != H ]] || git check-ref-format "$to" || return 1
        continue
      fi
      case "$path" in "$root"/*) ;; *) log_err "Journal path escapes project"; return 1 ;; esac
      case "$path/" in */../*|*/./*) log_err "Invalid journal path"; return 1 ;; esac
    done
    kinds+=("$kind"); froms+=("$from"); tos+=("$to")
  done < "$journal/operations"
  for ((i=${#kinds[@]}-1; i>=0; i--)); do
    from="${froms[i]}"; to="${tos[i]}"
    case "${kinds[i]}" in
      C)
        if [[ -e "$from" || -L "$from" ]]; then
          [[ ! -L "$from" && -f "$from" && "$(git hash-object --no-filters -- "$from")" == "$to" ]] || return 1
          rm "$from" || return 1
        fi
        ;;
      L)
        if [[ -L "$from" && "$(readlink "$from")" == "$to" ]]; then
          rm "$from" || return 1
        elif [[ -e "$from" || -L "$from" ]]; then
          log_err "Generated state changed during recovery: $from"; return 1
        fi
        ;;
      H)
        [[ ! -d "$from/.git" ]] || git -C "$from" symbolic-ref HEAD "$to" || return 1
        ;;
      W)
        if [[ -f "$to/.git" ]]; then
          git -C "$from" worktree remove "$to" || return 1
        elif [[ -d "$to" ]]; then
          rmdir "$to" || return 1
        fi
        ;;
      M)
        if [[ -e "$to" || -L "$to" ]]; then
          [[ ! -e "$from" && ! -L "$from" ]] || { log_err "Recovery conflict: $from"; return 1; }
          mv "$to" "$from" || return 1
        fi
        ;;
      D)
        if [[ "$from" == "$root/workspaces/main/.hap-state" && -d "$from" ]]; then
          # Receipts refer only to files removed by the journal above.
          for path in "$from"/*; do
            [[ ! -f "$path" || -L "$path" ]] || rm "$path" || return 1
          done
        fi
        [[ ! -d "$from" ]] || rmdir "$from" || return 1
        ;;
    esac
  done
  rm -f "$journal/operations" "$journal/template" || return 1
  rmdir "$journal/staging" 2>/dev/null || true
  rmdir "$journal" || return 1
  log_info "Initialization rolled back; original files restored"
}

hap_init() (
  set -e -o pipefail
  local project_root project_name="" repo name branch item shared_files data_files
  local state_stopped=false recover=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --state-stopped) state_stopped=true ;;
      --recover) recover=true ;;
      -*) log_err "Unknown init option: $1"; return 1 ;;
      *) [[ -z "$project_name" ]] || { log_err "Unexpected argument: $1"; return 1; }; project_name="$1" ;;
    esac
    shift
  done
  project_root=$(pwd -P)
  if [[ "$recover" == true ]]; then
    recover_init "$project_root"
    return
  fi
  project_name="${project_name:-${project_root##*/}}"
  validate_name "$project_name" project || return 1
  command -v git >/dev/null || { log_err "Missing dependency: git"; return 1; }
  INIT_JOURNAL="$project_root/.hap-init-journal"
  [[ ! -e "$INIT_JOURNAL" && ! -L "$INIT_JOURNAL" ]] || {
    log_err "An unfinished initialization exists. Inspect it, then run hap init --recover"; return 1;
  }
  local root_repo=false
  local -a repos=() branches=() shared_reports=() data_reports=()
  [[ ! -f "$project_root/.git" && ! -L "$project_root/.git" ]] || { log_err "Init requires an ordinary Git checkout"; return 1; }
  if [[ -d "$project_root/.git" ]]; then
    root_repo=true
    repos+=("$project_name")
  else
    for item in "$project_root"/sources "$project_root"/workspaces "$project_root"/shared "$project_root"/data "$project_root"/config; do
      [[ ! -e "$item" && ! -L "$item" ]] || { log_err "Reserved directory already exists: $item"; return 1; }
    done
    for item in "$project_root"/*; do
      [[ ! -f "$item/.git" && ! -L "$item/.git" ]] || { log_err "Linked repositories are not supported by init: $item"; return 1; }
      [[ -d "$item/.git" && ! -L "$item" ]] || continue
      name="${item##*/}"
      validate_name "$name" repository || return 1
      repos+=("$name")
    done
  fi
  [[ ${#repos[@]} -gt 0 ]] || { log_err "No supported Git repositories found"; return 1; }
  for name in "${repos[@]}"; do
    repo="$project_root/$name"
    [[ "$root_repo" == false ]] || repo="$project_root"
    git -C "$repo" rev-parse --verify HEAD >/dev/null || { log_err "Repository has no commit: $repo"; return 1; }
    local worktrees entry worktree_count=0
    worktrees=$(git -C "$repo" worktree list --porcelain) || return 1
    while IFS= read -r entry; do
      [[ "$entry" != 'worktree '* ]] || worktree_count=$((worktree_count + 1))
    done <<< "$worktrees"
    [[ $worktree_count -eq 1 ]] || {
      log_err "Existing linked worktrees must be preserved separately before init: $repo"
      return 1
    }
    branch=$(git -C "$repo" symbolic-ref --quiet --short HEAD) || {
      log_err "Check out a branch before initialization: $repo"; return 1;
    }
    local dirty ignored
    dirty=$(git -C "$repo" status --porcelain --untracked-files=all) || return 1
    [[ -z "$dirty" ]] || {
      log_err "Commit or preserve local changes and untracked files before init: $repo"
      return 1
    }
    while IFS= read -r -d '' ignored; do
      case "${ignored##*/}" in
        *.db|*.sqlite|*.sqlite3|*-wal|*-shm|*-journal)
          [[ "$state_stopped" == true ]] || {
            log_err "Stop database users, then rerun init --state-stopped: $repo/$ignored"
            return 1
          }
          ;;
      esac
      case "${ignored##*/}" in
        .env|.env.*|*.pem|*.crt|*.key|*.db|*.sqlite|*.sqlite3|*-wal|*-shm|*-journal|*.log) ;;
        *) log_err "Preserve or remove ignored files before init: $repo/$ignored"; return 1 ;;
      esac
    done < <(git -C "$repo" ls-files --others --ignored --exclude-standard -z)
    branches+=("$branch")
  done

  local script_dir template
  script_dir=$(cd "$(dirname "$0")" && pwd -P)
  template="${script_dir%/*}/templates/hap.kdl"
  [[ -f "$template" ]] || template="$DATA_DIR/templates/hap.kdl"
  mkdir -m 700 "$INIT_JOURNAL"
  : > "$INIT_JOURNAL/operations"
  trap 'rc=$?; trap - EXIT; if [[ $rc -ne 0 ]]; then recover_init "$project_root" || log_err "Recovery paused; inspect .hap-init-journal and run hap init --recover"; fi; exit "$rc"' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  [[ ! -f "$template" ]] || cp "$template" "$INIT_JOURNAL/template"
  if [[ "$root_repo" == true ]]; then
    mkdir "$INIT_JOURNAL/staging"
    for item in "$project_root"/* "$project_root"/.[!.]* "$project_root"/..?*; do
      [[ -e "$item" || -L "$item" ]] || continue
      [[ "$item" != "$INIT_JOURNAL" ]] || continue
      init_move "$item" "$INIT_JOURNAL/staging/${item##*/}"
    done
  fi
  for name in sources workspaces/main shared data config; do
    init_mkdir "$project_root/$name"
  done
  local i
  for ((i=0; i<${#repos[@]}; i++)); do
    name="${repos[i]}"; branch="${branches[i]}"
    if [[ "$root_repo" == true ]]; then
      init_move "$INIT_JOURNAL/staging" "$project_root/sources/$name"
    else
      init_move "$project_root/$name" "$project_root/sources/$name"
    fi
    repo="$project_root/sources/$name"
    shared_files=$(extract_shared_state "$repo" "$project_root/shared/$name")
    data_files=$(extract_data_state "$repo" "$project_root/data/workspaces/main/$name")
    shared_reports+=("$shared_files")
    data_reports+=("$data_files")
    init_record H "$repo" "refs/heads/$branch"
    git -C "$repo" checkout --detach
    init_record W "$repo" "$project_root/workspaces/main/$name"
    git -C "$repo" worktree add "$project_root/workspaces/main/$name" "$branch"
    setup_workspace_repo "$project_root" "$project_root/workspaces/main" "$name"
  done
  if [[ -f "$INIT_JOURNAL/template" ]]; then
    init_move "$INIT_JOURNAL/template" "$project_root/config/hap.kdl"
  fi
  hap_add "$project_name" "$project_root"
  # Only journal-owned files remain here; never recursively remove a migration tree.
  rm "$INIT_JOURNAL/operations"
  rmdir "$INIT_JOURNAL"
  trap - EXIT INT TERM
  for ((i=0; i<${#repos[@]}; i++)); do
    print_state_extraction_summary "${repos[i]}" "${shared_reports[i]}" "${data_reports[i]}" "$project_root"
  done

  log_succ "Project initialized: $project_name"
  log_info "Edit config/hap.kdl, then run hap open $project_name"
)

# --- COMMANDS ---

hap_open() {
  local project="" workspace="" editor="zellij" base_branch="" target_branch="" profile=""
  local list_profiles=false
  START_UP="false"
  FETCH_BASE=false
  REUSE_BRANCH=false
  SHARED_CONFIG=false
  SHARED_DATA=false
  INSTALL_DEPS=false
  PUBLISH_BRANCH=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
    --shared-config) SHARED_CONFIG=true; shift ;;
    --shared-data) SHARED_DATA=true; shift ;;
    --install) INSTALL_DEPS=true; shift ;;
    --publish) PUBLISH_BRANCH=true; shift ;;
    --fetch) FETCH_BASE=true; shift ;;
    --reuse-branch) REUSE_BRANCH=true; shift ;;
    -u)
      START_UP="true"
      shift
      ;;
    -e)
      editor="${2:?'-e requires an editor name'}"
      shift 2
      ;;
    -b)
      base_branch="${2:?'-b requires a branch name'}"
      shift 2
      ;;
    -B)
      target_branch="${2:?'-B requires a branch name'}"
      shift 2
      ;;
    -p | --profile)
      # Missing or incomplete value → list profiles after project is known
      if [[ -z "${2:-}" || "$2" == -* ]]; then
        list_profiles=true
        shift
      else
        profile="$2"
        shift 2
      fi
      ;;
    -*)
      log_err "Unknown option: $1"
      log_err "Usage: hap open <project> [workspace] [-u] [-p profile] [-e editor] [-b branch] [-B branch]"
      exit 1
      ;;
    *)
      if [[ -z "$project" ]]; then
        project="$1"
      elif [[ -z "$workspace" ]]; then
        workspace="$1"
      else
        log_err "Unexpected argument: $1"
        exit 1
      fi
      shift
      ;;
    esac
  done

  if [[ -z "$project" ]]; then
    log_err "Project name required"
    log_err "Usage: hap open <project> [workspace] [-u] [-p profile] [-e editor]"
    exit 1
  fi

  ensure_setup "$editor"

  validate_name "$project" project || return 1

  local path_to_root
  path_to_root=$(registry_get "$project") || return 1
  if [[ -z "$path_to_root" ]]; then
    log_err "Project not found: $project"
    exit 1
  fi

  validate_project_root "$path_to_root" || return 1

  if [[ "$list_profiles" == true ]]; then
    if list_project_profiles "$path_to_root"; then
      exit 0
    fi
    log_err "No profiles found in $path_to_root/config/profiles/"
    exit 1
  fi

  # Fail fast on bad / incomplete profile before touching sessions/workspaces
  if [[ -n "$profile" ]]; then
    resolve_layout_file "$path_to_root" "$profile" >/dev/null || exit 1
  fi

  if [[ -n "$workspace" ]]; then
    create_workspace "$path_to_root" "$project" "$workspace" "$base_branch" "$editor" "$target_branch" "$profile"
  else
    create_workspace "$path_to_root" "$project" main "$base_branch" "$editor" "$target_branch" "$profile"
  fi
}

registry_validate() {
  local name path row seen=$'\n'
  while IFS= read -r row || [[ -n "$row" ]]; do
    [[ -n "$row" ]] || continue
    [[ "$row" == *'|'* && "${row#*|}" != *'|'* ]] || { log_err "Invalid registry delimiter"; return 1; }
    name="${row%%|*}"; path="${row#*|}"
    validate_name "$name" project || return 1
    [[ "$path" == /* && "$path" != *$'\r'* ]] || { log_err "Invalid registry row for $name"; return 1; }
    [[ "$seen" != *$'\n'"$name"$'\n'* ]] || { log_err "Duplicate project: $name"; return 1; }
    seen+="$name"$'\n'
  done < "$DB_FILE"
}

registry_get() {
  local wanted="$1" name path
  registry_validate || return 1
  while IFS='|' read -r name path || [[ -n "$name" ]]; do
    if [[ "$name" == "$wanted" ]]; then
      printf '%s\n' "$path"
      return 0
    fi
  done < "$DB_FILE"
  log_err "Project not found: $wanted"
  return 1
}

registry_rewrite() (
  local name="$1" path="${2:-}" tmp_db="" lock="$DATA_DIR/.registry.lock" attempts=0
  until mkdir -m 700 "$lock" 2>/dev/null; do
    attempts=$((attempts + 1))
    [[ $attempts -lt 100 && ! -L "$lock" ]] || { log_err "Registry is busy: $lock"; return 1; }
    sleep 0.05
  done
  trap '[[ -z "$tmp_db" ]] || rm -f "$tmp_db"; rmdir "$lock"' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  registry_validate || return 1
  [[ ! -L "$DB_FILE" ]] || { log_err "Refusing a symlinked registry"; return 1; }
  tmp_db=$(mktemp "$DATA_DIR/.projects.XXXXXXXX") || return 1
  awk -F '|' -v key="$name" '$1 != key' "$DB_FILE" > "$tmp_db" || return 1
  [[ -z "$path" ]] || printf '%s|%s\n' "$name" "$path" >> "$tmp_db" || return 1
  mv "$tmp_db" "$DB_FILE"
)

hap_add() {
  local name="${1:?'Project name required. Usage: hap add <name> [path]'}" path="${2:-.}" full_path
  validate_name "$name" project || return 1
  full_path=$(cd -- "$path" && pwd -P) || return 1
  case "$full_path" in *'|'*|*$'\n'*|*$'\r'*) log_err "Project paths cannot contain pipes or line breaks"; return 1 ;; esac
  ensure_db || return 1
  registry_rewrite "$name" "$full_path" || return 1
  log_succ "Registered: $name → $full_path"
}

hap_remove() {
  local name="${1:?'Project name required. Usage: hap remove <name>'}"
  validate_name "$name" project || return 1
  ensure_db || return 1
  registry_get "$name" >/dev/null || return 1
  registry_rewrite "$name" || return 1
  log_succ "Removed: $name"
}

hap_clean() {
  local project="" workspace=""
  DELETE_REMOTE="false"
  CONFIRM_YES="false"

  while [[ $# -gt 0 ]]; do
    case "$1" in
    -D)
      DELETE_REMOTE="true"
      shift
      ;;
    -y)
      CONFIRM_YES="true"
      shift
      ;;
    -*)
      log_err "Unknown option: $1"
      log_err "Usage: hap clean <project> [workspace] [-D] [-y]"
      exit 1
      ;;
    *)
      if [[ -z "$project" ]]; then
        project="$1"
      elif [[ -z "$workspace" ]]; then
        workspace="$1"
      else
        log_err "Unexpected argument: $1"
        exit 1
      fi
      shift
      ;;
    esac
  done

  if [[ -z "$project" ]]; then
    log_err "Project name required"
    log_err "Usage: hap clean <project> [workspace] [-D] [-y]"
    exit 1
  fi

  validate_name "$project" project || return 1
  ensure_db

  local path_to_root
  path_to_root=$(registry_get "$project") || return 1
  if [[ -z "$path_to_root" ]]; then
    log_err "Project not found: $project"
    exit 1
  fi

  with_project_lock "$path_to_root" cleanup_project_workspaces "$path_to_root" "$workspace" "$project"
}

hap_list() {
  ensure_db
  if [[ ! -s "$DB_FILE" ]]; then
    log_warn "No projects registered. Use 'hap init' to get started."
    exit 0
  fi
  column -t -s "|" "$DB_FILE"
}

hap_interactive() {
  ensure_setup "zellij"
  START_UP="false"

  if [[ ! -s "$DB_FILE" ]]; then
    log_warn "No projects found. Use 'hap init' in your project directory."
    exit 0
  fi

  local selection
  selection=$(fzf --height=40% --layout=reverse --border --prompt="Select project > " --delimiter="|" --with-nth=1,2 <"$DB_FILE")
  if [[ -n "$selection" ]]; then
    local name path_to_root
    name=$(echo "$selection" | cut -d '|' -f 1)
    path_to_root=$(echo "$selection" | cut -d '|' -f 2)
    launch_session "$name" "$path_to_root/workspaces/main" "$name-main" "$path_to_root" "zellij"
  fi
}

# --- CLI ---

usage() {
  cat <<EOF
Usage: hap <command> [args] [flags]

Commands:
  init [name]                    Scaffold project from current directory
  open <project> [workspace]     Open project or workspace
  add <name> [path]              Register a project
  remove <name>                  Unregister a project
  clean <project> [workspace]    Cleanup workspace(s)
  list                           List registered projects
  help                           Show this help
  version                        Show version

Flags for 'open':
  -u              Auto-start servers (like docker compose up)
  -p, --profile   Layout profile from config/profiles/<name>.kdl
                  Omit the name (hap open <project> -p) to list profiles
  -e <editor>     Editor: zellij (default), cursor, antigravity
  -b <branch>     Base branch for new workspace (default: dev)
  -B <branch>     Target branch name (default: hap/<workspace>)

Flags for 'clean':
  -D              Also delete remote branches
  -y              Skip confirmation (with -D)

Run 'hap' with no arguments for interactive project selection.
EOF
}

# --- MAIN ---

case "${1:-}" in
init)
  shift
  hap_init "$@"
  ;;
open)
  shift
  hap_open "$@"
  ;;
add)
  shift
  hap_add "$@"
  ;;
remove)
  shift
  hap_remove "$@"
  ;;
clean)
  shift
  hap_clean "$@"
  ;;
list) hap_list ;;
version | -v | --version) echo "hap v$VERSION" ;;
help | -h | --help) usage ;;
"") hap_interactive ;;
*)
  log_err "Unknown command: $1"
  echo ""
  usage
  exit 1
  ;;
esac
