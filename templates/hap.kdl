layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    // Workspace root: each source repository is a child directory.
    // Customize command/cwd here, e.g. command="nvim" cwd="./app".
    tab name="code" focus=true {
        pane name="code" command="bash"
        pane name="agent" command="bash"
    }

    // Replace the printf with your start command and set the repository cwd.
    // HAP_UP is set only for `hap open -u`; it affects new sessions only.
    // HAP_DATA_DIR is the selected workspace data root. Applications must use it
    // explicitly, e.g. DB_PATH="$HAP_DATA_DIR/app/dev.db" ./start-server.
    tab name="servers" {
        pane name="server" command="bash" {
            args "-c" "if [ \"$HAP_UP\" = \"1\" ]; then printf 'Set your server command in config/hap.kdl\\n'; fi; exec bash"
        }
        pane name="shell" command="bash"
    }
}
